{
  "name": "jumanly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hostinger": "prisma migrate deploy && prisma db seed && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:reduced": "E2E_REDUCED_MOTION=1 playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "messages": "tsx scripts/build-messages.ts",
    "messages:check": "tsx scripts/build-messages.ts --check",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "email:dev": "email dev --dir emails --port 3001",
    "postinstall": "prisma generate",
    "predev": "pnpm messages",
    "prebuild": "tsx scripts/build-messages.ts --check && tsx scripts/build-brand-assets.ts --check",
    "prepare": "husky",
    "brand": "tsx scripts/build-brand-assets.ts",
    "brand:check": "tsx scripts/build-brand-assets.ts --check",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "jobs:billing": "tsx scripts/run-billing-jobs.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore-check": "tsx scripts/db-backup.ts restore-check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "1.0.12",
    "@react-pdf/renderer": "4.9.0",
    "@sparticuz/chromium": "153.0.0",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "hls.js": "1.6.15",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.2",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "puppeteer-core": "25.14.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@react-email/ui": "6.11.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "react-email": "6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
