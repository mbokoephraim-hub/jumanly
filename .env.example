# Copier ce fichier en « .env » puis compléter. Ne jamais committer « .env ».
# Liste alignée sur docs/specifications.md (partie 02). Les services sont branchés étape par étape ;
# tant qu'une clé est vide, un adaptateur factice est utilisé.

# ─── Application ────────────────────────────────────────────────
# local | preview | staging | production (partie 03, § 3.7). Vide = local.
# La page /dev/composants n'existe qu'en local et en preview.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fuseau par défaut pour afficher les dates (stockées en UTC) tant que celui de l'utilisateur est inconnu.
DEFAULT_TIME_ZONE=UTC

# ─── Base de données (docker compose up -d) ─────────────────────
DATABASE_URL=postgresql://jumanly:jumanly@localhost:5432/jumanly

# ─── Authentification · Better Auth (étape E2) ──────────────────
# Secret d'au moins 32 caractères : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresse exacte du site (même port) : sert à vérifier l'origine des formulaires.
BETTER_AUTH_URL=http://localhost:3000
# Premier administrateur d'un environnement hébergé (sans accès à la base) : cette adresse devient
# administrateur à sa première connexion, une fois vérifiée. À retirer ensuite. Plusieurs : virgules.
ADMIN_BOOTSTRAP_EMAIL=
# Compte passe-partout (mode testeur) : ces adresses, une fois vérifiées, ouvrent /app/testeur pour
# passer d'un forfait à l'autre sans paiement (talent, organisation de test). Journalisé. Plusieurs : virgules.
TESTER_EMAILS=
# Connexion par Google, Apple et LinkedIn : chaque bouton n'apparaît que si ses clés sont
# remplies. Marche à suivre chez chaque service : docs/deploiement-vercel.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : identifiant du Services ID et secret client (jeton signé avec la clé .p8, valable 6 mois).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Facultatif : identifiant d'une future appli iOS (bundle ID).
APPLE_APP_BUNDLE_IDENTIFIER=
# LinkedIn : appli avec le produit « Sign In with LinkedIn using OpenID Connect ».
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── E-mails · Resend ou boîte mail (SMTP) ──────────────────────
# Vide en local : les e-mails sont affichés dans la console (adaptateur factice).
RESEND_API_KEY=
# Sinon, une boîte mail existante (Gmail : smtp.gmail.com, 465, l'adresse, un mot de passe d'application).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Facultatif (local, tests) : chaque e-mail factice est aussi ajouté à ce fichier, une ligne JSON par e-mail.
EMAIL_OUTBOX_FILE=
# Avec SMTP, laisser vide : l'expéditeur est alors l'adresse de la boîte (SMTP_USER).
EMAIL_FROM="Jumanly <assistant@jumanly.io>"
# Seuls contacts publics : jamais de numéro de téléphone (CLAUDE.md § 8).
CONTACT_EMAIL_PRO=assistant@jumanly.io
CONTACT_EMAIL_GENERAL=infojumanly@gmail.com

# ─── Stockage de fichiers · S3 compatible ───────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Vidéo (Learn) ──────────────────────────────────────────────
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Nom d'hôte de diffusion de la bibliothèque (ex. vz-xxxxxxxx-xxx.b-cdn.net). Vide : vidéos désactivées.
BUNNY_STREAM_CDN_HOSTNAME=

# ─── IA · API Claude ────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Identifiants de modèles : jamais écrits dans le code (CLAUDE.md § 12).
AI_MODEL_DEFAULT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_MAX_TOKENS_DEFAULT=8000
# Budget mensuel d'IA en USD (facultatif) : /admin/ia alerte à 80 % et au-delà de 100 %.
AI_MONTHLY_BUDGET_USD=
# « fake » : réponses par règles, sans appel au modèle (tests). Sans ANTHROPIC_API_KEY, idem.
AI_PROVIDER=
# Voix des simulations d'entretien : « browser » (par défaut : synthèse et dictée du navigateur,
# aucun son ne passe par Jumanly) ou « none » (questions affichées, réponses tapées).
NEXT_PUBLIC_VOICE_PROVIDER=browser
# Proximité sémantique du matching : « voyage » (Voyage AI, multilingue) ou vide (calcul local
# par mots partagés, sans coût). Le modèle est choisi ici, jamais dans le code.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ─── Paiements (factices tant que vides) ────────────────────────
PAYMENTS_MOBILE_MONEY_PROVIDER=
PAYMENTS_MOBILE_MONEY_API_KEY=
PAYMENTS_MOBILE_MONEY_WEBHOOK_SECRET=
# Fournisseur factice (local et previews) : secret de signature de ses webhooks de test.
PAYMENTS_FAKE_WEBHOOK_SECRET=
PAYMENTS_CARD_PROVIDER=
PAYMENTS_CARD_API_KEY=
PAYMENTS_CARD_WEBHOOK_SECRET=

# ─── Cache, tâches de fond, suivi ───────────────────────────────
REDIS_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Secret du planificateur qui appelle POST /api/jobs/billing toutes les heures (rappels, délai de
# grâce, retour au gratuit). Vide : la route est fermée ; `pnpm jobs:billing` fait la même chose.
JOBS_SECRET=
# Sur Vercel : même rôle, envoyé automatiquement par Vercel Cron (vercel.json). Peut valoir JOBS_SECRET.
CRON_SECRET=
# Rapports d'erreurs du serveur vers Sentry (vide : erreurs seulement dans les journaux).
# Voir docs/exploitation.md pour les alertes à créer.
SENTRY_DSN=
# Version déployée, jointe aux rapports d'erreurs (facultatif, par exemple le commit).
APP_VERSION=
# Sauvegardes (pnpm db:backup) et test de restauration (pnpm db:restore-check, base de test vide).
BACKUP_DIR=
RESTORE_CHECK_DATABASE_URL=
NEXT_PUBLIC_POSTHOG_KEY=

# ─── Export PDF des CV (Chromium, docs/modeles-cv § 6.3) ───────────────
# Sur Vercel, @sparticuz/chromium est utilisé. Ailleurs, le Chromium de Playwright
# (pnpm exec playwright install chromium), ou ce chemin s'il est renseigné.
CHROMIUM_PATH=
