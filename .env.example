# Copier ce fichier en « .env » puis compléter. Ne jamais committer « .env ».

# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fuseau horaire d'affichage des dates (ex. Africa/Kinshasa, Africa/Abidjan).
NEXT_PUBLIC_FUSEAU_HORAIRE=UTC

# ─── Base de données (docker compose up -d) ─────────────────────
DATABASE_URL=postgresql://jumanly:jumanly@localhost:5432/jumanly

# ─── Authentification · Better Auth (étape E2) ──────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── E-mails · Resend (étape E1) ────────────────────────────────
# Vide en local : les e-mails sont affichés dans la console (adaptateur factice).
RESEND_API_KEY=
EMAIL_EXPEDITEUR=Jumanly <assistant@jumanly.io>

# ─── Stockage de fichiers · S3 compatible (étape E3) ────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Tâches en arrière-plan · Inngest (étape E4) ────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── IA · API Claude (étape E6) ─────────────────────────────────
ANTHROPIC_API_KEY=
# Identifiants de modèles : jamais écrits dans le code.
IA_MODELE_PRINCIPAL=
IA_MODELE_RAPIDE=
IA_MODELE_EMBEDDINGS=

# ─── Paiements (étape E2 : factice, étape E7 : réels) ───────────
PAIEMENT_ADAPTATEUR=factice
MOBILE_MONEY_CLE_API=
MOBILE_MONEY_SECRET_WEBHOOK=
CARTE_CLE_API=
CARTE_SECRET_WEBHOOK=
