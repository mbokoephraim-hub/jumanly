// Jumanly data model (docs/specifications.md, partie 04).
// Tables are added at the step that first needs them. E1: plans and entitlements,
// organizations, skills, jobs, courses, contact messages. E2: accounts (Better Auth), memberships,
// subscriptions, payments, usage counters, overrides, audit log, first talent profile fields.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Forfaits et droits (partie 05) ─────────────────────────────
// Plans and entitlements live in the database and are edited in the admin.
// Code never tests a plan code or name, only entitlement keys (CLAUDE.md § 2).

/// Theme of the signed-in space: Clair (Crème, white cards) or Vert (Sapin to Nuit, glass cards).
/// Appearance of the talent space (docs/refonte-mobile, brief § 2.10): auto follows the phone.
enum UserAppearance {
  auto
  light
  dark
}

enum PlanFamily {
  talent
  rh
  company
  partner
}

enum EntitlementType {
  boolean
  level
  limit
}

model Plan {
  id             String            @id @default(cuid(2))
  code           String            @unique
  family         PlanFamily
  name           String
  tagline        String
  /// Prefix of this plan's interface texts, e.g. "pricing.talent.pro" (features, CTA, badge).
  contentKey     String
  /// USD cents; null = on quote.
  priceCents     Int?
  currency       String            @default("USD")
  interval       String            @default("month")
  isPublic       Boolean           @default(true)
  isPurchasable  Boolean           @default(true)
  recommended    Boolean           @default(false)
  sortOrder      Int
  active         Boolean           @default(true)
  entitlements   PlanEntitlement[]
  subscriptions  Subscription[]    @relation("SubscriptionPlan")
  pendingFor     Subscription[]    @relation("SubscriptionPendingPlan")
  payments       Payment[]
  licenseBatches LicenseBatch[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([family, sortOrder])
}

model PlanEntitlement {
  id     String          @id @default(cuid(2))
  planId String
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    String
  type   EntitlementType
  /// Text value: "true", "fundamentals", "150", "-1" (unlimited), "contract".
  value  String

  @@unique([planId, key])
  @@index([key])
}

// ─── Organisations ──────────────────────────────────────────────

enum OrganizationType {
  recruiter
  company
  partner
}

enum OrgVerificationStatus {
  none
  pending
  verified
  rejected
  /// The administrator asked for more (Admin v2, étape 4); back to pending when the organization answers.
  info_requested
}

model Organization {
  id                      String                   @id @default(cuid(2))
  type                    OrganizationType
  name                    String
  slug                    String                   @unique
  /// Square logo, address of its 256 px WebP (`/medias/orgs/…`, prompt 4 bis).
  logo                    String?
  /// Wide 3:1 banner shown on job cards and pages, address of its 1000 px WebP (prompt 4 bis).
  banner                  String?
  /// Banner chosen among the four Modèle B colours (sapin, nuit, lime, creme) when no image is
  /// uploaded (sign-up of the administrator, étape 3 A1).
  bannerTheme             String?
  /// « Recrute en ce moment » on the company page, chosen by its administrators (étape 3, A3).
  hiringNow               Boolean                  @default(false)
  /// Étapes de l'ATS des nouvelles offres : clés du catalogue (`stageCatalog`), null = étapes par défaut (étape 3, A5).
  pipelineTemplate        Json?
  /// Grille d'entretien par défaut des offres sans grille : [{ name, description }], null = compétences requises (étape 3, A5).
  scorecardCriteria       Json?
  description             String?
  website                 String?
  country                 String?
  city                    String?
  sector                  String?
  size                    String?
  /// Year the company was created, shown in « À propos » of its page (Ephraïm 27/10/2026).
  foundedYear             Int?
  /// Present in several countries: its page says « International » instead of its seat's flag.
  international           Boolean                  @default(false)
  /// { linkedin, instagram, x, facebook } as https addresses (`src/lib/social-links.ts`).
  socialLinks             Json?
  verifiedAt              DateTime?
  /// Profile fields shown on the public page (partie 07 § 4).
  legalName               String?
  /// company, consultant, ngo, public, education (`org.profile.type.*`).
  category                String?
  contactEmail            String?
  /// Verification by Jumanly (admin, E8). `verifiedAt` stays the badge's source.
  verificationStatus      OrgVerificationStatus    @default(none)
  /// { registration, taxId, domainEmail, mandate } as typed by the organization.
  verificationRequest     Json?
  verificationRequestedAt DateTime?
  verificationReason      String?
  verifiedById            String?
  parentId                String?
  parent                  Organization?            @relation("OrganizationEntities", fields: [parentId], references: [id])
  entities                Organization[]           @relation("OrganizationEntities")
  jobs                    Job[]
  memberships             Membership[]
  invitations             Invitation[]
  conversations           Conversation[]
  teams                   Team[]
  orgEntities             OrgEntity[]
  talentPools             TalentPool[]
  contactRequests         ContactRequest[]
  contactBlocks           ContactBlock[]
  interviews              Interview[]
  messageTemplates        MessageTemplate[]
  /// Partner organizations only (E9): bank, university, foundation, company, cooperation, public.
  partnerKind             String?
  licenseBatches          LicenseBatch[]
  /// Supporting documents of the verification request (Admin v2, étape 4).
  documents               OrganizationDocument[]
  joinRequests            OrgJoinRequest[]
  tasks                   OrgTask[]
  declaredMembers         OrgDeclaredMember[]
  /// Experiences of people linked to the company's page (logo and link on their profile).
  experiences             Experience[]
  /// Suspended by a Jumanly administrator: jobs hidden, Hire closed to its members.
  suspendedAt             DateTime?
  suspensionReason        String?
  /// Jobs that were live when the organization was suspended, published again on reactivation.
  suspendedJobIds         String[]                 @default([])
  /// Le Fil (Modèle B, lot B3): the organization's posts and who follows it.
  feedPosts               FeedPost[]
  feedFollowers           FeedFollow[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  hiddenTalentSuggestions HiddenTalentSuggestion[]
  teamThreads             TeamThread[]
}

/// A supporting document (PDF or image) sent with a verification request. The bytes live in the
/// file storage (`src/server/storage`), under `storageKey`.
model OrganizationDocument {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageKey     String       @unique
  name           String
  contentType    String
  size           Int
  uploadedById   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Files kept in the database by the default storage driver (no S3 configured).
model StoredFile {
  key         String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// ─── Référentiel de compétences ─────────────────────────────────

model Skill {
  id       String         @id @default(cuid(2))
  name     String
  slug     String         @unique
  aliases  String[]
  category String
  jobs     JobSkill[]
  courses  CourseSkill[]
  profiles ProfileSkill[]
}

// ─── Offres (Jobs) ──────────────────────────────────────────────

enum ContractType {
  cdi
  cdd
  stage
  mission
  freelance
  alternance
  volontariat
}

enum RemoteMode {
  onsite
  hybrid
  remote
}

enum JobStatus {
  draft
  /// Flagged by the automatic check: waiting for an administrator (partie 10 § 10.7).
  pending_review
  published
  closed
  archived
  /// Refused by moderation; the recruiter can correct and submit again.
  rejected
  /// Sent back by moderation with the points to correct; resubmitted, it goes back to review.
  changes_requested
  /// Put on hold by the recruiter (brief recruteur § 2.4): hidden from results, applications kept,
  /// can be resumed; never counted in `jobs.active.max`.
  paused
}

enum JobSkillKind {
  hard
  soft
}

enum SkillImportance {
  required
  preferred
}

model Job {
  id                      String             @id @default(cuid(2))
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id])
  title                   String
  slug                    String             @unique
  description             String
  /// One item per line.
  responsibilities        String[]
  requirements            String[]
  benefits                String[]
  process                 String[]
  contractType            ContractType
  city                    String
  country                 String
  remote                  RemoteMode
  /// USD cents per month; optional.
  salaryMin               Int?
  salaryMax               Int?
  currency                String             @default("USD")
  experienceMin           Int                @default(0)
  educationLevelMin       String?
  /// [{ code: "fr", level: "C1" }]
  languagesRequired       Json               @default("[]")
  /// Explicit criteria set by the recruiter: ["Permis B", …]
  knockoutCriteria        Json               @default("[]")
  status                  JobStatus          @default(draft)
  publishedAt             DateTime?
  /// Set when the end of a paid plan put this offer back in draft (partie 09 § 9.2); restored
  /// automatically when the organization pays again, within its limit.
  pausedByBillingAt       DateTime?
  /// When the recruiter paused the job (status `paused`).
  pausedAt                DateTime?
  closesAt                DateTime?
  /// Number of positions to fill (planche recruteur-1 CR1).
  openings                Int                @default(1)
  /// Field of the job, a key of `studyFields` (src/lib/studies.ts).
  domain                  String?
  /// Documents asked to candidates (cv, letter, diploma, portfolio): asked, never required to apply.
  requestedDocuments      String[]           @default([])
  /// Screening questions [{ id, text, kind: "yesno" | "text" }]: never block an application.
  screeningQuestions      Json               @default("[]")
  /// What candidates should know before applying (optional, step 3 of the job form).
  applicationInstructions String?
  /// Optional job sheet in PDF (checked: type, size, no active content), in the file storage.
  jobSheetKey             String?
  jobSheetName            String?
  jobSheetSize            Int?
  jobSheetPages           Int?
  /// Text of each page of the job sheet, for the reader and Orbi (data, never instructions).
  jobSheetText            Json?
  createdById             String?
  createdBy               User?              @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Recruiter in charge (« attribution des offres », partie 05 § 2.3).
  assignedToId            String?
  assignedTo              User?              @relation("JobAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  teamId                  String?
  team                    Team?              @relation("JobTeam", fields: [teamId], references: [id], onDelete: SetNull)
  departmentId            String?
  department              Team?              @relation("JobDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  entityId                String?
  entity                  OrgEntity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  /// Scorecard template: [{ name, description }] (`hire.scorecards`).
  scorecardTemplate       Json               @default("[]")
  /// Members given access to this job only (hiring managers, per-job permissions).
  assignments             JobAssignment[]
  contactRequests         ContactRequest[]
  /// Message sent by default when a candidate is not selected; editable each time.
  rejectionTemplate       String?
  /// Automatic check results (`admin.jobs.autoFlag.*`) and the moderator's reason.
  moderationFlags         String[]
  moderationReason        String?
  /// Points to correct ticked by the moderator (`admin.jobs.fix.*`), with `changes_requested`.
  moderationChecks        String[]           @default([])
  /// ATS (recruteur lot 6): Orbi analyses every application once, at the closing date
  /// (`ats.scheduled`); the credits are only used then. The member who asked it, for the consent.
  atsAtClose              Boolean            @default(false)
  atsScheduledById        String?
  /// « Ajouter les nouvelles au classement »: each application received after an analysis is read
  /// when it arrives (one credit each).
  atsAutoAdd              Boolean            @default(false)
  /// Last time Orbi analysed the applications of this job (now or at the closing date).
  atsRanAt                DateTime?
  /// The analysis running now: { startedAt, by, ids, stoppedAt?, finishedAt?, failed? } (one at a
  /// time per job). The page follows it; the member can leave and is told at the end.
  atsRun                  Json?
  /// End-of-offer reminders already sent (`jobs.ending_reminders`): ["d7", "d3", "d1", "d0"]
  /// with the closing date they were for, so that a new date sends them again.
  endingReminders         Json               @default("[]")
  skills                  JobSkill[]
  /// « L'entreprise » of the job sheet (publication étape par étape, 29/10/2026): the company's
  /// « À propos » taken over or rewritten for this offer; null shows the company's own.
  companyAbout            String?
  /// Title of the Fil post published with the offer (60 characters, rules of the Fil).
  feedTitle               String?
  /// Its text (160 characters, optional). The post is published when the offer goes live.
  feedText                String?
  /// Authentication number of the job sheet generated by Jumanly (« JMLY-7K3Q-9XA2 »), checked on
  /// /verifier/<code>; set the first time the sheet is drawn.
  sheetCode               String?            @unique
  /// Studies accepted (« Licence ou Master »), chosen by the recruiter; `educationLevelMin` is the
  /// lowest of them, read by the matching.
  educationLevels         String[]           @default([])
  /// The recruiter confirmed holding the ONEM authorization to publish and hire (RDC), at publish.
  onemConfirmedAt         DateTime?
  stages                  PipelineStage[]
  applications            Application[]
  savedBy                 SavedJob[]
  applicationDrafts       ApplicationDraft[]
  matchResults            MatchResult[]
  viewDays                JobViewDay[]
  feedPosts               FeedPost[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status, publishedAt])
}

/// Views of a job's page, one row per day (UTC): the real figures of « Mes offres » and
/// « Performance » (planche recruteur-1 r2, r4). No person is recorded.
model JobViewDay {
  jobId String
  job   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  day   DateTime @db.Date
  count Int      @default(0)

  @@id([jobId, day])
}

model JobSkill {
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance
  /// Technical (hard) or behavioural (soft) skill, the two lists of the job form.
  kind       JobSkillKind    @default(hard)
  weight     Int             @default(3)
  minLevel   Int             @default(2)

  @@id([jobId, skillId])
}

// ─── Formations (Learn) ─────────────────────────────────────────

enum CourseLevel {
  beginner
  intermediate
  advanced
}

/// Catalog level a course requires; plans grant one through `learn.catalog.level`.
enum CatalogLevel {
  free
  fundamentals
  standard
  advanced
  specialized
}

/// Editorial line of a course (Learn v2, étape 1): who stands behind its content.
enum EditorialLine {
  originals
  expert_series
  partner_programs
}

/// A domain of the catalog (Learn v2, étape 1): Career & Employability, AI & Digital Tools…
/// Created by the migration, edited in the admin; a course belongs to one domain at most.
model LearningDomain {
  id          String         @id @default(cuid(2))
  slug        String         @unique
  name        String
  description String         @default("")
  /// Name of a brand icon (`Icon`), chosen in the admin.
  icon        String         @default("learn")
  order       Int            @default(0)
  courses     Course[]
  paths       LearningPath[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([order])
}

/// Learn v2, étape 2: a path is an ordered series of courses (Domaine → Parcours → Formation).
/// A course keeps its own access level; the path adds no access of its own.
model LearningPath {
  id            String               @id @default(cuid(2))
  slug          String               @unique
  title         String
  summary       String               @default("")
  domainId      String?
  domain        LearningDomain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  editorialLine EditorialLine        @default(originals)
  status        CourseStatus         @default(draft)
  publishedAt   DateTime?
  courses       LearningPathCourse[]
  followers     LearningPathFollow[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, domainId])
}

model LearningPathCourse {
  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int

  @@id([pathId, courseId])
  @@index([courseId])
}

/// A learner who follows a path (« Mes parcours »). Progress comes from the course enrollments.
model LearningPathFollow {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId    String
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  startedAt DateTime     @default(now())

  @@id([userId, pathId])
  @@index([pathId])
}

/// Learn v2, étape 3: where a learner stopped in a lesson video, to resume at the second.
/// Completion stays in `Enrollment.completedLessons`; this table only keeps the position.
model LessonProgress {
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  positionSeconds Int      @default(0)
  durationSeconds Int?
  updatedAt       DateTime @updatedAt

  @@id([userId, lessonId])
  @@index([lessonId])
}

enum CourseStatus {
  draft
  review
  published
  archived
}

enum LessonKind {
  video
  text
  exercise
  quiz
  resource
}

model Course {
  id                 String               @id @default(cuid(2))
  slug               String               @unique
  title              String
  summary            String
  description        String
  objectives         String[]
  audience           String
  category           String
  /// Domain of the catalog (Learn v2); null until the team files the course.
  domainId           String?
  domain             LearningDomain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  editorialLine      EditorialLine        @default(originals)
  level              CourseLevel
  language           String               @default("fr")
  durationMinutes    Int
  coverUrl           String?
  requiredLevel      CatalogLevel
  /// Job families of the course's job-specific exercises (`learn.exercises.job_specific`).
  jobFamilies        String[]             @default([])
  status             CourseStatus         @default(draft)
  certificateEnabled Boolean              @default(true)
  instructor         String?
  prerequisites      String?
  enrollmentCount    Int                  @default(0)
  publishedAt        DateTime?
  modules            CourseModule[]
  skills             CourseSkill[]
  enrollments        Enrollment[]
  savedBy            SavedCourse[]
  inPaths            LearningPathCourse[]
  documents          CourseDocument[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, publishedAt])
  @@index([domainId])
}

model CourseModule {
  id       String   @id @default(cuid(2))
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  lessons  Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String               @id @default(cuid(2))
  moduleId    String
  module      CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  kind        LessonKind
  videoId     String?
  durationSec Int                  @default(0)
  content     Json?
  /// Visible without an account.
  isPreview   Boolean              @default(false)
  /// Job-specific exercise (`learn.exercises.job_specific`): optional, not counted in progress.
  jobSpecific Boolean              @default(false)
  /// [{ title, url, type, sizeKb }]: files to download (PDF supports…).
  resources   Json                 @default("[]")
  transcript  String?
  quiz        Quiz?
  notes       LessonNote[]
  progress    LessonProgress[]
  documents   CourseDocument[]
  submissions ExerciseSubmission[]

  @@unique([moduleId, order])
}

// ─── Documents PDF des formations (Admin v3, étape 5) ──────────────
// Files live in the private storage (never under `public/`), downloaded through a route that
// checks the visibility, the enrollment, the catalog level and `learn.resources.specialized`.

enum CourseDocumentKind {
  support
  exercises
  reading
  template
  answer_key
  other
}

enum CourseDocumentVisibility {
  /// On the public course page, for everyone.
  public
  /// Enrolled talents whose plan opens the course.
  enrolled
  /// The Jumanly team only (an answer key always is).
  team
}

model CourseDocument {
  id          String                   @id @default(cuid(2))
  courseId    String
  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Attached to one lesson; null = the whole course. A deleted lesson leaves it on the course.
  lessonId    String?
  lesson      Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  kind        CourseDocumentKind
  visibility  CourseDocumentVisibility @default(enrolled)
  /// Reserved to accounts with `learn.resources.specialized`.
  specialized Boolean                  @default(false)
  storageKey  String                   @unique
  size        Int
  pages       Int
  order       Int
  downloads   Int                      @default(0)
  /// Who sent the file (kept as an id: the audit log has the details).
  authorId    String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([courseId, order])
}

enum QuestionType {
  single
  multiple
  text
}

/// The evaluation of a lesson of kind `quiz`.
model Quiz {
  id           String        @id @default(cuid(2))
  lessonId     String        @unique
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passingScore Int           @default(70)
  /// 0 = unlimited.
  maxAttempts  Int           @default(0)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id          String       @id @default(cuid(2))
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order       Int
  type        QuestionType
  prompt      String
  options     String[]
  /// Indices of the right options (single, multiple) or accepted answers (text).
  answer      String[]
  explanation String?

  @@unique([quizId, order])
}

model Enrollment {
  id               String       @id @default(cuid(2))
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// 0 to 100.
  progress         Int          @default(0)
  completedLessons String[]
  lastLessonId     String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  certificate      Certificate?

  @@unique([userId, courseId])
}

model QuizAttempt {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// 0 to 100.
  score     Int
  /// { [questionId]: string[] }
  answers   Json
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, quizId])
}

/// Attestation of a finished course. Name, title and hours are copied at delivery.
model Certificate {
  id           String     @id @default(cuid(2))
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Public number, also used in the verification address (JMN-XXXX-XXXX).
  code         String     @unique
  holderName   String
  courseTitle  String
  hours        Int
  issuedAt     DateTime   @default(now())
  revokedAt    DateTime?
  /// Refonte mobile, lot 5: copied at delivery for the PDF (null on attestations issued before).
  domain       String?
  modules      Int?
  /// Best score of the course's quizzes (0 to 100), null when the course has none.
  score        Int?
  skills       String[]   @default([])
  /// Ed25519 signature (base64) of the canonical payload (`certificate-signature.ts`), by the key
  /// `keyId`. Signed on delivery, or on first display for an older attestation.
  signature    String?
  keyId        String?
  signedAt     DateTime?
  /// Shown on the talent's profile to recruiters (« Visible sur mon profil »).
  onProfile    Boolean    @default(true)
}

/// Refonte mobile, lot 5: what a learner hands in for a lesson of kind `exercise` (a file or one
/// of their CVs). Orbi may reread it; it never does the exercise for them.
model ExerciseSubmission {
  id         String   @id @default(cuid(2))
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// A file in the private storage, or one of the learner's CVs.
  storageKey String?  @unique
  fileName   String?
  size       Int?
  documentId String?
  createdAt  DateTime @default(now())

  @@index([userId, lessonId])
}

/// Private notes of a learner on a lesson.
model LessonNote {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

model SavedCourse {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
}

model CourseSkill {
  courseId     String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill  @relation(fields: [skillId], references: [id])
  levelGranted Int    @default(2)

  @@id([courseId, skillId])
}

// ─── Liste d'attente (site public, avant l'ouverture des inscriptions) ───

enum WaitlistProfile {
  talent
  recruiter
  company
  partner
}

/// Someone who joined the waitlist from /liste-attente. One row per address: joining again updates it.
model WaitlistEntry {
  id           String          @id @default(cuid(2))
  /// Lower-case address.
  email        String          @unique
  firstName    String
  lastName     String?
  profile      WaitlistProfile
  /// Country name as chosen in the form.
  country      String
  city         String?
  organization String?
  /// Language of the site when joining ("fr" or "en"): the confirmation e-mail uses it.
  locale       String          @default("fr")
  /// Set once the confirmation e-mail has left.
  emailSentAt  DateTime?
  /// Test of the platform (30/10/2026): last invitation sent with the hidden sign-up link.
  invitedAt    DateTime?
  inviteCount  Int             @default(0)
  /// End of the test period: the questionnaire leaves on its own after this date (hourly job).
  testEndsAt   DateTime?
  /// Secret part of the questionnaire link (`/questionnaire-test/<token>`), set at the invitation.
  surveyToken  String?         @unique
  surveySentAt DateTime?
  feedback     TestFeedback?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([createdAt])
  @@index([profile])
  @@index([testEndsAt])
}

/// Answers to the end-of-test questionnaire (30/10/2026): one per invited person, read in the admin.
model TestFeedback {
  id           String        @id @default(cuid(2))
  entryId      String        @unique
  entry        WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Ratings from 1 to 5.
  overall      Int
  ease         Int
  design       Int
  usefulness   Int
  speed        Int
  /// « Recommanderiez-vous Jumanly ? » from 0 to 10.
  recommend    Int
  /// Parts of the platform tried (keys of `testAreas`).
  areas        String[]
  /// phone, computer or tablet.
  device       String
  liked        String?
  problems     String?
  improvements String
  comments     String?
  locale       String        @default("fr")
  createdAt    DateTime      @default(now())

  @@index([createdAt])
}

// ─── Formulaire de contact ──────────────────────────────────────

model ContactMessage {
  id           String   @id @default(cuid(2))
  /// "contact" (form /contact) or "partners" (form /partenaires).
  audience     String
  /// Subject code from the form (account, quote, partners…).
  subject      String
  name         String
  email        String
  organization String?
  country      String?
  message      String
  /// Extra answers (quote: users, entities; partners: type, role, beneficiaries, plan, duration).
  details      Json     @default("{}")
  /// Mailbox the message was forwarded to.
  routedTo     String
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
}

// ─── Comptes (Better Auth) ──────────────────────────────────────
// Field names of User, Session, Account, Verification, TwoFactor and RateLimit follow Better Auth.

enum PlatformRole {
  user
  content_editor
  /// Responsable carrière (27/10/2026): conseils et FAQ, offres, IA et matching.
  career_manager
  /// Modération (27/10/2026): offres et signalements.
  moderator
  support_agent
  platform_admin
}

enum UserStatus {
  active
  suspended
  /// Account deleted and anonymized (partie 10): kept only so applications and payments stay whole.
  deleted
}

model User {
  id                   String                    @id @default(cuid(2))
  name                 String
  email                String                    @unique
  emailVerified        Boolean                   @default(false)
  image                String?
  firstName            String?
  lastName             String?
  country              String?
  city                 String?
  locale               String                    @default("fr")
  platformRole         PlatformRole              @default(user)
  status               UserStatus                @default(active)
  /// Consent to AI suggestions (CLAUDE.md § 12): date of consent, null when withdrawn.
  aiConsentAt          DateTime?
  newsletter           Boolean                   @default(false)
  /// « Réduire les animations » (docs/experience-animee § 0.4): no motion in the signed-in space.
  reduceMotion         Boolean                   @default(false)
  /// Clair, Sombre or Auto (follows the phone), docs/refonte-mobile brief § 2.10.
  appearance           UserAppearance            @default(auto)
  /// Full welcome intro seen (docs/refonte-connexion § 7): played once per account, on any device.
  introSeenAt          DateTime?
  termsAcceptedAt      DateTime?
  /// Account deletion requested: effective at this date unless the user signs in again.
  deletionScheduledAt  DateTime?
  twoFactorEnabled     Boolean                   @default(false)
  /// Notification categories turned off in Paramètres › Notifications (applications, messages,
  /// learning, billing): no in-app notification of that category is created for the person.
  notificationsMuted   String[]                  @default([])
  /// « Recevoir aussi par e-mail » (Paramètres › Notifications): reminders also sent by e-mail.
  /// Receipts and security e-mails are always sent.
  notificationEmails   Boolean                   @default(true)
  /// Last page seen in the signed-in space, for « En ligne » (recruteur lot 6). Never shown when
  /// `showPresence` is off.
  lastSeenAt           DateTime?
  /// « Montrer quand je suis en ligne » (Paramètres): off, nobody sees it, and the person does not
  /// see the others either.
  showPresence         Boolean                   @default(true)
  /// « Accusés de lecture » (Paramètres): off, « Lu » is neither sent nor shown, both ways.
  readReceipts         Boolean                   @default(true)
  /// End-of-offer reminders (Paramètres › Messagerie et rappels): any of ["d7", "d3", "d1", "d0"],
  /// J-3 only by default (brief recruteur § 2.16 bis).
  endingReminders      String[]                  @default(["d3"])
  joinRequests         OrgJoinRequest[]
  recruiterProfile     RecruiterProfile?
  sessions             Session[]
  accounts             Account[]
  twoFactors           TwoFactor[]
  memberships          Membership[]
  talentProfile        TalentProfile?
  diagnostics          CareerDiagnostic[]
  diagnosticDraft      CareerDiagnosticDraft?
  profilePhoto         ProfilePhoto?
  profileBanner        ProfileBanner?
  savedJobs            SavedJob[]
  applicationDrafts    ApplicationDraft[]
  jobsCreated          Job[]                     @relation("JobCreator")
  jobsAssigned         Job[]                     @relation("JobAssignee")
  /// Applications a colleague entrusted to this member (Modèle B recruteur M5, « Répartir »).
  applicationsAssigned Application[]             @relation("ApplicationAssignee")
  orgTasks             OrgTask[]                 @relation("OrgTaskAssignee")
  orgTasksGiven        OrgTask[]                 @relation("OrgTaskAssigner")
  jobAssignments       JobAssignment[]
  scorecards           Scorecard[]
  talentPools          TalentPool[]
  contactRequestsSent  ContactRequest[]
  interviewsOrganized  Interview[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  participations       ConversationParticipant[]
  messageReactions     MessageReaction[]
  videoCalls           VideoCall[]
  incomingCalls        VideoCall[]               @relation("VideoCallCallee")
  connectionsSent      Connection[]              @relation("ConnectionRequester")
  connectionsReceived  Connection[]              @relation("ConnectionAddressee")
  enrollments          Enrollment[]
  learningPaths        LearningPathFollow[]
  /// Le Fil (Modèle B, lot B3).
  feedPosts            FeedPost[]                @relation("FeedPostAuthor")
  feedLikes            FeedLike[]
  feedReposts          FeedRepost[]
  feedSaves            FeedSave[]
  feedFollows          FeedFollow[]              @relation("FeedFollower")
  feedFollowers        FeedFollow[]              @relation("FeedFollowedUser")
  feedHiddenTypes      FeedHiddenType[]
  feedEvents           FeedEventParticipant[]
  feedImages           FeedImage[]
  audience             AudienceEvent[]
  quizAttempts         QuizAttempt[]
  lessonNotes          LessonNote[]
  exerciseSubmissions  ExerciseSubmission[]
  lessonProgress       LessonProgress[]
  savedCourses         SavedCourse[]
  aiUsages             AiUsage[]
  orbiConversations    OrbiConversation[]
  aiSuggestions        AiSuggestion[]
  matchDisputes        MatchDispute[]            @relation("DisputeAuthor")
  progressPlan         ProgressPlan?
  licenses             License[]
  interviewSessions    InterviewSession[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  hiddenTalentSuggestions HiddenTalentSuggestion[]
  teamThreadsA            TeamThread[]             @relation("TeamThreadA")
  teamThreadsB            TeamThread[]             @relation("TeamThreadB")
  teamMessages            TeamMessage[]            @relation("TeamMessageAuthor")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Appartenances (partie 05 § 5) ──────────────────────────────

enum MembershipRole {
  org_owner
  org_admin
  recruiter
  hiring_manager
  viewer
  partner_manager
}

enum MembershipStatus {
  invited
  active
  removed
  /// Beyond the seats of the free plan after a paid plan ended: no access, nothing deleted.
  suspended
}

model Membership {
  id             String           @id @default(cuid(2))
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  status         MembershipStatus @default(active)
  /// Job title given at sign-up (« Votre fonction »).
  jobTitle       String?
  /// « Droits de … » (étape 3, A2): the switches set by an administrator, as { publish, sort,
  /// interviews, evaluate, stats, page } → boolean. null = every right the role allows.
  rights         Json?
  /// Team scope (`org.permissions.level` advanced): a recruiter then sees their team's jobs.
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─── Abonnements, paiements, quotas (parties 05, 09) ────────────

enum SubjectType {
  user
  organization
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
  sponsored
}

enum SubscriptionSource {
  self
  license
  admin
}

model Subscription {
  id                 String             @id @default(cuid(2))
  subjectType        SubjectType
  subjectId          String
  planId             String
  plan               Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Downgrade taking effect at the end of the paid period.
  pendingPlanId      String?
  pendingPlan        Plan?              @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  source             SubscriptionSource @default(self)
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([subjectType, subjectId])
}

enum PaymentMethod {
  mobile_money
  card
  /// Recorded by an administrator (Admin v2, étape 5): bank transfer or cash.
  bank_transfer
  cash
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  refunded
}

model Payment {
  id              String        @id @default(cuid(2))
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  /// Who pays and for which plan, kept even before the subscription exists.
  subjectType     SubjectType
  subjectId       String
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  provider        String
  method          PaymentMethod
  operator        String?
  /// Mobile Money number, masked (e.g. ••••••4521); never stored in full.
  msisdnMasked    String?
  amountCents     Int
  currency        String        @default("USD")
  status          PaymentStatus @default(pending)
  providerRef     String        @unique
  idempotencyKey  String        @unique
  failureReason   String?
  /// new, renewal, upgrade (partie 09 § 9.2), for the revenue indicators.
  kind            String        @default("new")
  /// Credit for the unused time of the previous plan, already deducted from amountCents.
  creditCents     Int           @default(0)
  /// Who started the payment (receipt and invoice e-mails).
  payerId         String?
  refundedAt      DateTime?
  refundReference String?
  refundedById    String?
  invoice         Invoice?
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subjectType, subjectId])
}

/// Consumption of a quota for one period (rolling month from the subscription start).
model UsageCounter {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  periodStart DateTime
  periodEnd   DateTime
  used        Int         @default(0)

  @@unique([subjectType, subjectId, key, periodStart])
}

/// Per-subject entitlement value (commercial gesture, Premium contract).
model EntitlementOverride {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  value       String
  reason      String
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId])
}

// ─── Profil talent (début, complété en E3) ──────────────────────

enum ProfileVisibility {
  private
  recruiters
  anonymous
}

model TalentProfile {
  id                     String                   @id @default(cuid(2))
  userId                 String                   @unique
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  /// Title of « À propos » (« Ce que je fais »), above the summary on the phone profile.
  aboutTitle             String?
  summary                String?
  /// Main goal chosen on the welcome screen (firstJob, newJob, reconversion…).
  goal                   String?
  /// Level of studies chosen at the first connection (`access.onboarding.studies.level.*`).
  studyLevel             String?
  /// Field of studies chosen at the first connection (`access.onboarding.studies.field.*`).
  studyField             String?
  /// Situation chosen on the phone (Modèle B, profile step 4): student, graduate, seeking,
  /// employed or switching (`phoneAccueil.profile.situation.*`).
  situation              String?
  /// Banner chosen by the person (an /api/banniere/… address); null shows the drawn one.
  banner                 String?
  /// « @patrick.ilunga » (docs/profil-personne): letters, digits and dots, 3 to 30, unique. Null
  /// shows the one drawn from the name.
  handle                 String?                  @unique
  /// { linkedin?, instagram?, x?, facebook?, website? }: https addresses (src/lib/social-links.ts).
  socialLinks            Json                     @default("{}")
  /// « Afficher mon e-mail sur mon profil »: off by default.
  showEmail              Boolean                  @default(false)
  targetJob              String?
  visibility             ProfileVisibility        @default(private)
  availability           Availability             @default(open)
  availableFrom          DateTime?
  notice                 String?
  desiredJobTitles       String[]
  /// Values of `talent.profile.preferences.contract.*` (cdi, cdd, internship…).
  desiredContracts       String[]
  desiredLocations       String[]
  /// ISO 3166-1 codes of the countries where the person wants to work (screen 82). A country
  /// without any of its places in `desiredLocations` means « Tout le pays ».
  desiredCountries       String[]                 @default([])
  remotePreferences      RemoteMode[]
  relocation             Boolean                  @default(false)
  /// Never shown to recruiters. Whole USD (or `salaryCurrency`) per `salaryPeriod`.
  salaryMin              Int?
  salaryCurrency         String                   @default("USD")
  salaryPeriod           String                   @default("month")
  sectors                String[]
  /// [{ code: "fr", level: "native" | "fluent" | …, cefr?: "B2" }]
  languages              Json                     @default("[]")
  /// 0 to 100, recomputed on every profile change.
  completeness           Int                      @default(0)
  /// « Calcul de compatibilité » (Paramètres > Confidentialité). Off: no score anywhere.
  matchingEnabled        Boolean                  @default(true)
  /// « Recevoir des demandes de mise en relation » (Paramètres > Confidentialité).
  acceptsContactRequests Boolean                  @default(true)
  matchResults           MatchResult[]
  poolEntries            TalentPoolEntry[]
  contactRequests        ContactRequest[]
  skills                 ProfileSkill[]
  experiences            Experience[]
  educations             Education[]
  referenceChecks        ReferenceCheck[]
  documents              Document[]
  applications           Application[]
  /// Public portfolio (`career.portfolio.level`), at /portfolio/[slug] when published.
  portfolioSlug          String?                  @unique
  portfolioPublic        Boolean                  @default(false)
  portfolioIntro         String?
  /// classic | grid (the enriched level unlocks grid and the cover colour)
  portfolioLayout        String                   @default("classic")
  portfolioAccent        String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  hiddenSuggestions      HiddenTalentSuggestion[]
}

enum Availability {
  open
  listening
  not_looking
}

enum ExperienceType {
  job
  internship
  freelance
  volunteer
  entrepreneur
}

model Experience {
  id              String              @id @default(cuid(2))
  profileId       String
  profile         TalentProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  company         String
  /// The company's page on Jumanly, chosen among the suggestions while typing its name (demande
  /// d'Ephraïm du 29/10/2026): its logo and a link to its page. Unlinked when the page goes away.
  organizationId  String?
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// Logo sent by the person for a company without a page (`/medias/experiences/…`, 160 px WebP).
  logo            String?
  type            ExperienceType      @default(job)
  location        String?
  startDate       DateTime
  /// null = current position.
  endDate         DateTime?
  /// Réalisations clés: one achievement per line, in the person's order.
  description     String              @default("")
  createdAt       DateTime            @default(now())
  declaredAt      OrgDeclaredMember[]
  referenceChecks ReferenceCheck[]

  @@index([profileId])
  @@index([organizationId])
}

enum EducationLevel {
  none
  secondary
  vocational
  bachelor
  master
  doctorate
}

/// « Diplômes » and « Certificats » of the profile (demande d'Ephraïm du 29/10/2026).
enum EducationKind {
  /// Academic: fin des humanités, licence, master, doctorat…
  diploma
  /// A training followed, online or in person, short or long.
  certificate
}

enum TrainingFormat {
  online
  in_person
  hybrid
}

enum TrainingLength {
  short
  long
}

model Education {
  id              String           @id @default(cuid(2))
  profileId       String
  profile         TalentProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind            EducationKind    @default(diploma)
  degree          String
  level           EducationLevel
  field           String?
  school          String
  startYear       Int?
  /// null = in progress.
  endYear         Int?
  /// Certificates: how and how long the training was followed.
  format          TrainingFormat?
  length          TrainingLength?
  /// Photo of the certificate or of the diploma sent by the person (`/medias/formations/…`, WebP).
  /// For a diploma it is shown as « Justificatif joint », never as « Vérifié ».
  image           String?
  /// Logo of the school or of the training organization sent by the person, shown instead of the
  /// generic icon (`/medias/experiences/…`, like the logos of experiences).
  schoolLogo      String?
  /// « Ce que j'ai appris »: 2 to 3 short points, one per line.
  learnings       String           @default("")
  createdAt       DateTime         @default(now())
  referenceChecks ReferenceCheck[]

  @@index([profileId])
}

enum ReferenceCheckStatus {
  pending
  confirmed
  declined
  /// Withdrawn by the person, or the item changed after the answer.
  cancelled
}

/**
 * « Faire vérifier » (demande d'Ephraïm du 29/10/2026): a referent named by the person (a former
 * manager, the training organization) gets an e-mail and confirms an experience or a certificate
 * in one click. A confirmed check gives the item its « Vérifié » badge. Only the hash of the link's
 * token is kept.
 */
model ReferenceCheck {
  id            String               @id @default(cuid(2))
  profileId     String
  profile       TalentProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experienceId  String?
  experience    Experience?          @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  educationId   String?
  education     Education?           @relation(fields: [educationId], references: [id], onDelete: Cascade)
  referentName  String
  referentEmail String
  /// What links the referent to the person (« Responsable d'équipe »), optional.
  referentRole  String?
  tokenHash     String               @unique
  status        ReferenceCheckStatus @default(pending)
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime             @default(now())

  @@index([profileId])
  @@index([experienceId])
  @@index([educationId])
}

enum DocumentKind {
  cv
  cover_letter
  bio
  portfolio_item
  other
}

/// A CV (or later a letter): structured content, rendered by a template.
model Document {
  id              String        @id @default(cuid(2))
  profileId       String
  profile         TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind            DocumentKind
  title           String
  templateId      String        @default("classique")
  content         Json          @default("{}")
  /// CV settings (accent, font, density, photo, titles language, order, page breaks):
  /// docs/modeles-cv/SPECIFICATION-MODELES-CV.md § 5.3. Null = the template's defaults.
  style           Json?
  /// Pages counted at the last export.
  pageCount       Int?
  isPrimary       Boolean       @default(false)
  /// A colour the talent gives a CV to tell it apart in the library (Ephraïm, 29/10): a key of
  /// PROFILE_PALETTE (src/lib/profile-colors.ts), null for none.
  colorTag        String?
  /// Offer a CV was adapted to (« Adapter mon CV à cette offre »): proposed first when applying.
  /// A plain id, not a relation: the CV stays if the offer goes.
  adaptedForJobId String?
  /// The file a talent imported and kept as it is (« Garder mon CV », Ephraïm 27/10): PDF or Word,
  /// in the private file storage. Null for a CV made in Jumanly.
  fileKey         String?
  fileName        String?
  /// "pdf" | "docx".
  fileType        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([profileId, kind])
}

enum DiagnosticLevel {
  simple
  personalized
}

model CareerDiagnostic {
  id         String          @id @default(cuid(2))
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      DiagnosticLevel
  answers    Json
  result     Json
  /// « Refaire dans 30 jours »: a notification is sent at this date (hourly job).
  remindAt   DateTime?
  remindedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([remindAt])
}

/// Answers of a diagnostic in progress, saved at each answer so the talent can resume it.
model CareerDiagnosticDraft {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  /// Index of the screen the talent was on.
  step      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Candidatures (Jobs, partie 04) ─────────────────────────────

enum StageKind {
  new
  screening
  test
  interview
  offer
  hired
  rejected
}

model PipelineStage {
  id           String        @id @default(cuid(2))
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  kind         StageKind
  applications Application[]

  @@unique([jobId, order])
}

enum ApplicationStatus {
  active
  withdrawn
  rejected
  hired
}

enum ApplicationSource {
  direct
  invitation
  talent_search
}

model Application {
  id               String             @id @default(cuid(2))
  jobId            String
  job              Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId        String
  profile          TalentProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stageId          String
  stage            PipelineStage      @relation(fields: [stageId], references: [id])
  status           ApplicationStatus  @default(active)
  coverLetter      String?
  /// Copy of the CV as sent (title, template, content): later edits do not change it.
  cvSnapshot       Json?
  /// Documents joined to the application, copied as sent (refonte mobile lot 4): attestations
  /// [{ type: "certificate", code, title, issuedAt }] and texts [{ type: "document", title, text }].
  attachments      Json               @default("[]")
  /// Answers to the job's screening questions [{ id, question, answer }], all optional.
  screeningAnswers Json               @default("[]")
  source           ApplicationSource  @default(direct)
  /// Score and explanation shown when the talent applied (partie 08 § 8.10), frozen.
  matchScore       Int?
  matchExplanation Json?
  viewedAt         DateTime?
  /// « Liste des retenus » (recruteur lot 6): kept for the next stage by a member, never by Orbi.
  shortlistedAt    DateTime?
  shortlistedById  String?
  /// « Répartir à un collègue » (Modèle B recruteur M5): the member who follows the file.
  assignedToId     String?
  assignedTo       User?              @relation("ApplicationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  orgTasks         OrgTask[]
  events           ApplicationEvent[]
  conversation     Conversation?
  scorecards       Scorecard[]
  interviews       Interview[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([jobId, profileId])
  @@index([profileId, status])
  @@index([assignedToId])
}

model ApplicationEvent {
  id            String      @id @default(cuid(2))
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  /// submitted, stage_changed, note, message, document_requested, decision, withdrawn
  type          String
  payload       Json        @default("{}")
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model SavedJob {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

/// Application in progress (docs/ux-mobile-talent, prompt 4): saved at each step of the staged
/// form, removed when the application is sent. Never seen by the organization.
model ApplicationDraft {
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Last step reached: cv | lettre | verification.
  step             String   @default("cv")
  /// Chosen CV; null with `profileOnly` = « Mon profil Jumanly seul », null alone = not chosen yet.
  cvDocumentId     String?
  profileOnly      Boolean  @default(false)
  coverLetter      String   @default("")
  /// Documents joined at step 2 (refonte mobile lot 4): [{ type: "certificate" | "document", id }].
  attachments      Json     @default("[]")
  /// Answers to the screening questions, optional (refonte recruteur lot 2).
  screeningAnswers Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([userId, jobId])
  @@index([jobId])
}

enum SkillSource {
  declared
  course
  assessment
  cv_extracted
}

model ProfileSkill {
  id        String        @id @default(cuid(2))
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill         @relation(fields: [skillId], references: [id])
  /// 1 to 4: notions, intermediate, advanced, expert.
  level     Int           @default(2)
  source    SkillSource   @default(declared)
  verified  Boolean       @default(false)
  /// certificate, experience, project, link or null.
  proof     String?
  proofUrl  String?
  /// The attestation (Certificate id) or the project (Document id) chosen as proof (lot 6).
  proofRef  String?
  createdAt DateTime      @default(now())

  @@unique([profileId, skillId])
}

// ─── Contenus éditables (partie 04, /admin/contenus) ─────────────

/// A text edited in the admin that replaces the one from textes/ (FAQ), or a banner. An empty
/// value hides a FAQ question; no row means the original text.
model ContentBlock {
  id          String   @id @default(cuid(2))
  key         String
  locale      String   @default("fr")
  value       String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
}

/// The previous version of an editable content (Admin v2, étape 8), kept at each change so that
/// « Restaurer » can put it back. `item` names the content (`faq.talents.q3`, `banner.<id>`,
/// `tips.<id>`); `previous` maps each of its keys to its former value, null when it had none
/// (the original text of textes/ applied).
model ContentVersion {
  id          String   @id @default(cuid(2))
  item        String
  locale      String   @default("fr")
  previous    Json
  /// Why it changed (the reason given with the change).
  reason      String?
  /// content.faq.save, content.banner.delete, content.restore…
  action      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([item, locale, createdAt])
}

/// Kinds of running costs entered by an administrator (Admin v2, étape 2).
enum PlatformCostCategory {
  acquisition
  hosting
  ai_external
  other
}

/// A running cost of one month, entered in /admin/indicateurs/couts: the indicators derive the
/// acquisition cost, the cost per active user and the gross margin from these rows.
model PlatformCost {
  id          String               @id @default(cuid(2))
  /// First day of the month (UTC).
  month       DateTime
  category    PlatformCostCategory
  amountCents Int
  note        String?
  updatedById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([month, category])
}

// ─── Audit (partie 03 § 3.6) ────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid(2))
  actorId        String?
  action         String
  targetType     String
  targetId       String
  organizationId String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// ─── Hire et Connect (E4) ───────────────────────────────────────

model Invitation {
  id             String         @id @default(cuid(2))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole
  teamId         String?
  token          String         @unique
  invitedById    String?
  message        String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([email])
}

enum ConversationKind {
  application
  contact_request
  support
  /// Between two talents who accepted each other's connection request.
  peer
}

enum ConnectionStatus {
  pending
  accepted
  declined
  blocked
}

/// A connection between two talents (refonte mobile, lot 6): asked by one, accepted by the other.
model Connection {
  id           String           @id @default(cuid(2))
  requesterId  String
  requester    User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId  String
  addressee    User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       ConnectionStatus @default(pending)
  /// Who blocked the other one, when status is blocked.
  blockedById  String?
  /// A short word sent with the request (« Demandes de connexion », Modèle B lot B8).
  note         String?
  conversation Conversation?
  createdAt    DateTime         @default(now())
  respondedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

/// One conversation per application, between the talent and the hiring organization.
model Conversation {
  id               String                    @id @default(cuid(2))
  kind             ConversationKind
  applicationId    String?                   @unique
  application      Application?              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId   String?
  organization     Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The talent side of the conversation.
  talentUserId     String
  contactRequest   ContactRequest?
  /// For a peer conversation: the accepted connection it belongs to.
  connectionId     String?                   @unique
  connection       Connection?               @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Set when the talent blocks the organization: no more messages from it.
  blockedAt        DateTime?
  /// « Retirer de ma messagerie » (recruteur lot 6): hidden on the organization's side only, until
  /// a new message arrives. The talent keeps every message; nothing is deleted.
  orgHiddenAt      DateTime?
  /// « Épingler la conversation »: shown first in the organization's list.
  orgPinnedAt      DateTime?
  /// « Messages éphémères » (Modèle B lot B8, between two talents): new messages are hidden after
  /// this many seconds, for both sides. Null: off.
  ephemeralSeconds Int?
  participants     ConversationParticipant[]
  messages         Message[]
  videoCalls       VideoCall[]
  lastMessageAt    DateTime                  @default(now())
  createdAt        DateTime                  @default(now())

  @@index([organizationId, lastMessageAt])
  @@index([talentUserId, lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid(2))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  /// « Couper les notifications » of this conversation, for this person only.
  mutedAt        DateTime?
  /// « Effacer la discussion » (Modèle B lot B8): the messages before it are hidden for this person
  /// only; the other side keeps them and nothing is deleted.
  clearedAt      DateTime?
  /// « Épingler la discussion » (Chat v2): shown first in this person's list.
  pinnedAt       DateTime?
  /// Last keystroke in the composer (Chat v2): the other side reads « écrit… » for a few seconds.
  typingAt       DateTime?

  @@unique([conversationId, userId])
}

enum MessageKind {
  text
  document_request
  invitation
  system
  /// A file sent by its owner (CV, letter, document): payload { document }.
  file
  /// A time suggested in the conversation: payload { startsAt, timezone, durationMinutes }.
  slot
  /// A recruitment decision (rejected or hired), shown as a DecisionCard, never as a bubble.
  decision
  /// Photos sent from the phone (Modèle B lot B8): payload { files: [{ key, width, height }], hd }.
  image
  /// A voice note: payload { key, seconds, type }.
  voice
  /// A connection's card: payload { userId, name, line }.
  contact
  /// An organization's card: payload { slug, name, line }.
  organization
}

model Message {
  id             String            @id @default(cuid(2))
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  body           String
  kind           MessageKind       @default(text)
  /// document_request: { name, due, submittedAt?, document? } ; text with a document: { document }
  payload        Json              @default("{}")
  /// Hidden by moderation after a report.
  hiddenAt       DateTime?
  /// Sent while « Messages éphémères » was on: hidden for both sides after this time (never deleted).
  expiresAt      DateTime?
  reactions      MessageReaction[]
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// A reaction under a message (Chat v2): one per person and message, changed or taken back.
model MessageReaction {
  id        String   @id @default(cuid(2))
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

enum VideoCallStatus {
  ringing
  active
  ended
  missed
}

/// A call of a conversation (Chat v2), in audio or in video: only between connections, or with the
/// recruiter of an application. Nothing of the call itself is recorded: only who called whom, when,
/// how and how long. The two phones talk directly (WebRTC); the server only passes their
/// descriptions (`offer`, `answer`) while it rings, and forgets them when the call ends.
model VideoCall {
  id             String          @id @default(cuid(2))
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  callerId       String
  caller         User            @relation(fields: [callerId], references: [id], onDelete: Cascade)
  /// Who is called (the other talent, or the recruiter of the application).
  calleeId       String?
  callee         User?           @relation("VideoCallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  status         VideoCallStatus @default(ringing)
  /// « audio » or « video », as the caller chose; `answerMode` as the person called accepted it.
  mode           String          @default("video")
  answerMode     String?
  /// The call provider (`VIDEO_CALL_PROVIDER`: « webrtc », or « fake » in local) and its room.
  provider       String
  roomId         String
  /// The connection descriptions of the two phones (SDP), kept only until the call ends.
  offer          String?
  answer         String?
  answeredAt     DateTime?
  endedAt        DateTime?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
  @@index([calleeId, status])
}

model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// newApplication, statusChange, notSelected, newMessage, documentRequest, orgInvite, jobModerated
  type      String
  payload   Json      @default("{}")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// A phone or a browser that receives the notifications even outside the app (Web Push,
/// Ephraïm 29/10/2026). One line per device; a device that no longer answers is removed.
model PushSubscription {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Keys the platform makes for itself once and keeps (the Web Push key pair when VAPID_PUBLIC_KEY
/// and VAPID_PRIVATE_KEY are not set): nothing to configure by hand.
model PlatformKey {
  name      String   @id
  value     Json
  createdAt DateTime @default(now())
}

enum ReportStatus {
  open
  in_progress
  closed
}

model Report {
  id               String       @id @default(cuid(2))
  reporterId       String
  /// job, message, conversation, profile, organization
  targetType       String
  targetId         String
  reason           String
  details          String?
  status           ReportStatus @default(open)
  /// dismiss, hide, warn: always closed with a decision and a reason.
  resolution       String?
  resolutionReason String?
  resolvedById     String?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// ─── Jumanly Intelligence (partie 08) ───────────────────────────

/// Versioned weights of the eight criteria, edited in /admin/ia. The newest active one is used.
model MatchingWeights {
  id          String   @id @default(cuid(2))
  version     String   @unique
  /// { skills_required: 35, skills_preferred: 10, … }
  weights     Json
  activeFrom  DateTime @default(now())
  createdById String?
  note        String?
  createdAt   DateTime @default(now())
}

/// Last computed score of a profile for a job, with its explanation (cache, recomputed when stale).
model MatchResult {
  id             String        @id @default(cuid(2))
  profileId      String
  profile        TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score          Int
  band           String
  explanation    Json
  weightsVersion String
  computedAt     DateTime      @default(now())

  @@unique([profileId, jobId])
  @@index([jobId, score])
}

/// Embeddings for the semantic criterion (pgvector). Written and read with SQL.
model Embedding {
  id          String                 @id @default(cuid(2))
  /// profile or job
  subjectType String
  subjectId   String
  model       String
  contentHash String
  vector      Unsupported("vector")?
  updatedAt   DateTime               @updatedAt

  @@unique([subjectType, subjectId])
}

/// A conversation with Orbi, the talent's assistant (docs/refonte-mobile, talent lot 4 § 9). Kept
/// until the person erases it, one exchange or the whole history.
model OrbiConversation {
  id             String        @id @default(cuid(2))
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The first question, shortened: the line of the history.
  title          String
  /// cv, interview, offer, path, learn, other: the icon of the history.
  topic          String        @default("other")
  /// Recruiter lot 5: an exchange held from an organization's space (its credits, its history).
  /// Null for the talent's own exchanges.
  organizationId String?
  messages       OrbiMessage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, organizationId, updatedAt])
}

model OrbiMessage {
  id             String           @id @default(cuid(2))
  conversationId String
  conversation   OrbiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" or "orbi".
  role           String
  /// Paragraphs separated by a blank line.
  text           String
  /// Orbi only: proposed next steps, keys of a fixed list (`orbiActions`), never free links.
  actions        String[]         @default([])
  /// Orbi only: the « Pourquoi ? » of the answer.
  why            String?
  /// Orbi only: "ai" (the model wrote it) or "rules" (written without the model).
  source         String?
  /// Orbi only, without the model: consent, entitlement, quota or unavailable.
  limit          String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/// Every call to a language model (partie 03): feature, model, tokens, estimated cost.
model AiUsage {
  id             String   @id @default(cuid(2))
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  /// cv_parse, cv_coach, diagnostic, progress_plan, match_explain, hire_cv_analysis…
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicroUsd   Int      @default(0)
  planCode       String?
  /// ok, invalid (output rejected by validation), error
  status         String   @default("ok")
  createdAt      DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
}

enum SuggestionStatus {
  pending
  applied
  ignored
}

/// A suggestion of the CV coach (or the CV import): the talent applies or ignores it.
model AiSuggestion {
  id         String           @id @default(cuid(2))
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature    String
  documentId String?
  /// { section, before, after, why, kind… }
  payload    Json
  status     SuggestionStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, feature, status])
}

enum DisputeStatus {
  open
  in_review
  corrected
  confirmed
}

/// « Signaler une erreur » on a score: a person from Jumanly checks the calculation.
model MatchDispute {
  id              String        @id @default(cuid(2))
  userId          String
  user            User          @relation("DisputeAuthor", fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  applicationId   String?
  /// skill, experience, education, language, location, other
  reason          String
  details         String
  notifyRecruiter Boolean       @default(false)
  scoreBefore     Int
  scoreAfter      Int?
  status          DisputeStatus @default(open)
  resolution      String?
  resolvedById    String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// Individual progress plan (Starter and more): steps the talent can tick, edit or remove.
model ProgressPlan {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  /// [{ id, title, detail, kind: course|skill|profile|action, href?, done }]
  steps     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InterviewSimMode {
  text
  voice
}

enum InterviewSimStatus {
  active
  completed
}

/// An interview simulation (E10, partie 08 § 8.9): questions, answers, structured feedback.
/// Never a hireability score: the feedback names strengths and points to work on.
model InterviewSession {
  id              String             @id @default(cuid(2))
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            InterviewSimMode   @default(text)
  /// general | technical | behavioral | motivation
  type            String
  /// junior | intermediate | senior
  level           String
  jobTitle        String
  jobId           String?
  durationMinutes Int
  /// [{ question, answer, durationSec? }]
  questions       Json               @default("[]")
  /// { summary, criteria: [{ key, level, comment }], strengths[], improvements[], perQuestion[] }
  feedback        Json?
  status          InterviewSimStatus @default(active)
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
}

/// A signed webhook received from a payment provider, stored before processing (partie 09 § 9.4).
/// The unique (provider, eventId) makes a replayed webhook a no-op.
model PaymentEvent {
  id          String    @id @default(cuid(2))
  provider    String
  eventId     String
  providerRef String
  status      String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([providerRef])
}

/// Invoice of a successful payment: sequential number, what was billed, frozen at issue.
model Invoice {
  id            String      @id @default(cuid(2))
  /// JMN-2026-000001
  number        String      @unique
  sequence      Int         @unique
  paymentId     String      @unique
  payment       Payment     @relation(fields: [paymentId], references: [id])
  subjectType   SubjectType
  subjectId     String
  billedName    String
  billedEmail   String
  billedAddress String?
  billedTaxId   String?
  planName      String
  amountCents   Int
  creditCents   Int         @default(0)
  currency      String      @default("USD")
  periodStart   DateTime
  periodEnd     DateTime
  issuedAt      DateTime    @default(now())

  @@index([subjectType, subjectId])
}

/// What appears on the invoices of a user or an organization (« Informations de facturation »).
model BillingDetails {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  name        String
  address     String?
  taxId       String?
  email       String?
  updatedAt   DateTime    @updatedAt

  @@unique([subjectType, subjectId])
}

/// Idempotency keys of background tasks (reminders, grace, return to free): one row per action done.
model JobRun {
  key   String   @id
  ranAt DateTime @default(now())
}

// ─── Hire avancé et Companies (E8) ──────────────────────────────

enum TeamKind {
  team
  department
}

/// A recruiting team or a department of an organization (`org.teams`).
model Team {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           TeamKind     @default(team)
  leadId         String?
  entityId       String?
  entity         OrgEntity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  jobs           Job[]        @relation("JobTeam")
  departmentJobs Job[]        @relation("JobDepartment")
  pools          TalentPool[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind])
}

/// An entity or subsidiary inside an organization (`org.entities`).
model OrgEntity {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  country        String?
  parentId       String?
  parent         OrgEntity?   @relation("OrgEntityTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrgEntity[]  @relation("OrgEntityTree")
  verifiedAt     DateTime?
  teams          Team[]
  jobs           Job[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// A member given access to one job (per-job permissions, hiring managers).
model JobAssignment {
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, userId])
  @@index([userId])
}

enum ScorecardRecommendation {
  strong_yes
  yes
  no
  strong_no
  /// « Hésitation » (recruteur lot 4, planche r2plus EVAL).
  maybe
}

/// One evaluation per reviewer and application (`hire.scorecards`).
model Scorecard {
  id             String                  @id @default(cuid(2))
  applicationId  String
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User                    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  /// [{ name, rating 1-5, comment }]
  ratings        Json                    @default("[]")
  recommendation ScorecardRecommendation
  comment        String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([applicationId, reviewerId])
}

enum PoolVisibility {
  private
  team
  org
}

model TalentPool {
  id             String            @id @default(cuid(2))
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  visibility     PoolVisibility    @default(private)
  ownerId        String?
  owner          User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  entries        TalentPoolEntry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

model TalentPoolEntry {
  poolId    String
  pool      TalentPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  addedById String?
  note      String?
  createdAt DateTime      @default(now())

  @@id([poolId, profileId])
}

enum ContactRequestStatus {
  pending
  accepted
  declined
  expired
}

/// A recruiter asks a visible talent for a conversation; nothing is exchanged before consent.
model ContactRequest {
  id             String               @id @default(cuid(2))
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  profileId      String
  profile        TalentProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  message        String
  status         ContactRequestStatus @default(pending)
  expiresAt      DateTime
  respondedAt    DateTime?
  /// « Relancer » in « Mes propositions » (recruteur lot 6): once, while it waits.
  remindedAt     DateTime?
  /// When the talent first saw the proposal in Messages (Modèle B recruteur M6: « Vue, sans
  /// réponse »). Nothing else is learned about the talent.
  seenAt         DateTime?
  conversationId String?              @unique
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([profileId, status])
  @@index([organizationId, createdAt])
}

enum JoinRequestStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

/// « Demander à rejoindre » (recruteur lot 6, planche recruteur-4 § 6): a person who signs up finds
/// their organization already on Jumanly. Its owner or an administrator accepts (choosing the role)
/// or declines; without an answer within 7 days the request expires. Nobody enters without consent.
model OrgJoinRequest {
  id             String            @id @default(cuid(2))
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Why the organization was proposed: same e-mail domain, or same name.
  matchedBy      String
  /// « Votre message » to the administrators (Modèle B recruteur, M2), optional.
  message        String?
  status         JoinRequestStatus @default(pending)
  /// Role given on acceptance.
  role           MembershipRole?
  expiresAt      DateTime
  respondedAt    DateTime?
  respondedById  String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, status])
  @@index([userId, status])
}

/// « Ne plus recevoir de demandes de {company} ».
model ContactBlock {
  profileId      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([profileId, organizationId])
}

enum InterviewMode {
  video
  onsite
  audio
}

enum InterviewStatus {
  pending
  confirmed
  reschedule
  declined
  canceled
  done
  no_show
}

enum MessageTemplateKind {
  convocation
  document
  relance
  acceptation
  refus
}

/// A message template of an organization (prompt 5): always read and written with its organizationId.
model MessageTemplate {
  id             String              @id @default(cuid(2))
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           MessageTemplateKind
  title          String
  body           String
  updatedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, kind])
}

/// An interview invitation (`connect.appointments`): the recruiter proposes slots, the talent picks.
model Interview {
  id              String          @id @default(cuid(2))
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizerId     String
  organizer       User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  mode            InterviewMode
  durationMinutes Int
  /// Proposed by the recruiter (1 to 3).
  slots           DateTime[]
  /// Proposed back by the talent when asking for another time.
  proposedSlots   DateTime[]
  startsAt        DateTime?
  /// IANA time zone the slots were written in.
  timezone        String
  link            String?
  address         String?
  message         String?
  /// Members of the team who take part (collaborative interviews).
  participantIds  String[]
  /// Questions the team added to prepare it (recruteur lot 4): [{ id, text, authorId }]. Orbi's
  /// proposals are computed from the offer and the file, never stored.
  questions       Json            @default("[]")
  status          InterviewStatus @default(pending)
  cancelReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, startsAt])
  @@index([applicationId])
}

// ─── Jumanly Partners (E9) ──────────────────────────────────────

/// A batch of sponsored licences bought by a partner, created by the admin after the contract.
model LicenseBatch {
  id           String        @id @default(cuid(2))
  partnerOrgId String
  partnerOrg   Organization  @relation(fields: [partnerOrgId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan          @relation(fields: [planId], references: [id])
  name         String
  seats        Int
  /// Licence length for each beneficiary, capped by the end of the contract.
  months       Int
  startsAt     DateTime
  endsAt       DateTime
  contractRef  String?
  priceCents   Int?
  /// Report cells about fewer people than this are hidden (never below 10).
  minGroup     Int           @default(10)
  createdById  String?
  licenses     License[]
  links        LicenseLink[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([partnerOrgId])
}

enum LicenseStatus {
  available
  active
  revoked
  expired
}

/// One distributed licence: a code, an e-mail invitation or an activation through a link.
model License {
  id                       String        @id @default(cuid(2))
  batchId                  String
  batch                    LicenseBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// JMLY-XXXX-XXXX, stored without separators.
  code                     String        @unique
  label                    String?
  /// E-mail invitation: only this address can activate the code.
  invitedEmail             String?
  invitedAt                DateTime?
  linkId                   String?
  link                     LicenseLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  userId                   String?
  user                     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId           String?       @unique
  status                   LicenseStatus @default(available)
  activatedAt              DateTime?
  /// The beneficiary agreed that a declared hiring counts in the partner's reports.
  outcomeConsentAt         DateTime?
  outcomeConsentAnsweredAt DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([batchId, status])
  @@index([userId])
  @@index([batchId, invitedEmail])
}

/// An invitation link shared with a group; each use activates one licence of the batch.
model LicenseLink {
  id         String       @id @default(cuid(2))
  batchId    String
  batch      LicenseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  token      String       @unique
  maxUses    Int
  expiresAt  DateTime?
  disabledAt DateTime?
  licenses   License[]
  createdAt  DateTime     @default(now())
}

/// Profile photo (docs/ux-mobile-talent, prompt 6, screen 26): cropped and resized in the browser
/// (square JPEG), kept here and served at /api/photo/{token}: an unguessable address, renewed at
/// each change, shown where the person's avatar or CV is shown. Never used for matching (CLAUDE.md,
/// golden rule 4).
/// The banner of a talent's profile (Carrière, page of a person): one per account, served by
/// /api/banniere/[token]; a new picture gets a new address.
model ProfileBanner {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  contentType String
  bytes       Bytes
  updatedAt   DateTime @updatedAt
}

model ProfilePhoto {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  contentType String
  bytes       Bytes
  updatedAt   DateTime @updatedAt
}

/// Region used to order the country list (V8 § B1): RD Congo first, then Afrique centrale, Afrique
/// de l'Ouest, the rest of Africa, then the rest of the world.
enum PlaceRegion {
  central_africa
  west_africa
  other_africa
  world
}

enum LocalityKind {
  city
  province
}

/// ISO 3166-1 countries with their French name (reference, seeded everywhere).
model Country {
  code       String      @id
  name       String
  /// International dialling code (« +243 »), for the Mobile Money number of a payment.
  dialCode   String?
  region     PlaceRegion
  localities Locality[]
}

/// Main cities and provinces of a country (GeoNames), largest first by `rank`.
model Locality {
  id          String       @id @default(cuid())
  countryCode String
  country     Country      @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  name        String
  kind        LocalityKind @default(city)
  rank        Int          @default(0)

  @@unique([countryCode, name])
  @@index([countryCode, rank])
}

// ─── Le Fil (Modèle B, lot B3, docs/modele-b) ───────────────────

/// What a post is about: its tag in the Fil (« Nouveau poste », « Réalisation »…) and the
/// « type » a person can choose to see less of.
enum FeedPostKind {
  post
  newRole
  work
  certificate
  event
}

/// Who may answer a post (« Tout le monde peut répondre »).
enum FeedReplyPolicy {
  everyone
  connections
  nobody
}

/// A post of the Fil, or an answer to one (`parentId`). Written by a person (`authorId`) or in
/// the name of an organization (`organizationId`, with the member who wrote it as author).
model FeedPost {
  id             String                 @id @default(cuid(2))
  authorId       String?
  author         User?                  @relation("FeedPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           FeedPostKind           @default(post)
  /// The hook line of a post (docs/fil-menu-publication § 2): 60 characters at most; none for an
  /// answer, nor for the posts published before 26/10/2026.
  title          String?
  body           String
  /// A photo: an uploaded one (/api/fil/image/…) or a demo picture.
  imageUrl       String?
  imageAlt       String?
  /// An offer shown under the text, with the reader's score.
  jobId          String?
  job            Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// A piece of the author's career: { type: "work" | "certificate", id, title, detail }.
  attachment     Json?
  /// « Citer »: the post quoted under this one.
  quotedId       String?
  quoted         FeedPost?              @relation("FeedQuote", fields: [quotedId], references: [id], onDelete: SetNull)
  quotes         FeedPost[]             @relation("FeedQuote")
  /// An answer: the post it answers.
  parentId       String?
  parent         FeedPost?              @relation("FeedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        FeedPost[]             @relation("FeedReplies")
  replyPolicy    FeedReplyPolicy        @default(everyone)
  /// An event (« Portes ouvertes »): when it takes place.
  eventAt        DateTime?
  /// Taken down by moderation after a report.
  hiddenAt       DateTime?
  /// The author changed the title or the text (« modifié »).
  editedAt       DateTime?
  likes          FeedLike[]
  reposts        FeedRepost[]
  saves          FeedSave[]
  participants   FeedEventParticipant[]
  images         FeedImage[]
  createdAt      DateTime               @default(now())

  @@index([parentId, createdAt])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([organizationId, createdAt])
}

model FeedLike {
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// « Republier »: the post shown on the person's profile, without a comment.
model FeedRepost {
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

/// « Enregistrer »: kept for later, found again in Carrière.
model FeedSave {
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

/// A person who follows another person or an organization (« Abonnements »).
model FeedFollow {
  id             String        @id @default(cuid(2))
  followerId     String
  follower       User          @relation("FeedFollower", fields: [followerId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation("FeedFollowedUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([followerId, userId])
  @@unique([followerId, organizationId])
}

/// « Ne plus voir ce type de publication »: a kind of post (or « company ») the person sees no more.
model FeedHiddenType {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@id([userId, type])
}

/// « Je participe » to an event of the Fil.
model FeedEventParticipant {
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

/// A photo added to a post, served under an unguessable address.
model FeedImage {
  id          String    @id @default(cuid(2))
  token       String    @unique
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId      String?
  post        FeedPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  contentType String
  bytes       Bytes
  createdAt   DateTime  @default(now())
}

/// The recruiter's own profile, filled in seven steps at sign-up on a phone (Modèle B recruteur,
/// lot M2): what talents see of the person who recruits. Its existence marks an account that signed
/// up as a recruiter; the organization comes at step 5 (join, create, or independent).
model RecruiterProfile {
  id                     String    @id @default(cuid(2))
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// charge, rh, manager, dirigeant, cabinet, independant (`phoneRhOnboarding.role.*`).
  kind                   String?
  /// « Votre poste, tel qu'il s'affichera ».
  jobTitle               String?
  /// Professional e-mail: its domain helps the administrator validate the attachment.
  workEmail              String?
  /// Phone number without its country code, and the code's country (ISO 3166-1 alpha-2).
  phone                  String?
  phoneCountry           String?
  whatsapp               Boolean   @default(false)
  linkedin               String?
  /// Who sees the phone and LinkedIn: nobody, interview (candidates invited), connections.
  contactsFor            String    @default("interview")
  /// Other cities where the person recruits.
  otherCities            String[]  @default([])
  /// Domains, levels and hires per year (« Ce que vous recrutez »).
  domains                String[]  @default([])
  levels                 String[]  @default([])
  hiresPerYear           String?
  /// Which bio the profile shows (Ephraïm 29/10/2026): "recruiter" (`headline`) or "talent"
  /// (the talent profile's headline).
  bioSource              String    @default("recruiter")
  /// « Je recrute en indépendant·e »: offers show under the person's name.
  independent            Boolean   @default(false)
  /// The space opened under the person's own name while a request to join waits (or for an
  /// independent): becomes the company page if the person creates one.
  personalOrganizationId String?
  headline               String?
  /// « Recrute en ce moment » on the profile.
  hiringNow              Boolean   @default(true)
  /// « Le candidat que je recherche » (Ephraïm 27/10/2026), up to 400 characters.
  seeking                String?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// « Masquer ce profil de mes suggestions » (Modèle B recruteur M6): a talent left out of one
/// member's « Découvrir », still found by search. The talent is never told.
model HiddenTalentSuggestion {
  id             String        @id @default(cuid(2))
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileId      String
  profile        TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, organizationId, profileId])
}

/// « Équipe » of the recruiter's Messages (Modèle B recruteur M7): a conversation between two
/// members of the same organization. Apart from the talents' conversations: a talent never sees it,
/// another member of the organization neither. `memberAId` is the smaller of the two ids.
model TeamThread {
  id             String        @id @default(cuid(2))
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberAId      String
  memberA        User          @relation("TeamThreadA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberBId      String
  memberB        User          @relation("TeamThreadB", fields: [memberBId], references: [id], onDelete: Cascade)
  aReadAt        DateTime?
  bReadAt        DateTime?
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  messages       TeamMessage[]

  @@unique([organizationId, memberAId, memberBId])
  @@index([organizationId, lastMessageAt])
}

model TeamMessage {
  id        String     @id @default(cuid(2))
  threadId  String
  thread    TeamThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?      @relation("TeamMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// ─── Équipe de l'entreprise (étape 3, A2) ───────────────────────

enum OrgTaskKind {
  follow
  diagnostic
  interview
}

enum OrgTaskStatus {
  assigned
  accepted
  in_progress
  done
}

/// « Attribuer une tâche » (étape 3, A2, captures 076 et 077): an administrator entrusts a member
/// with a candidate (follow, evaluate the diagnostic, hold the interview). The member accepts,
/// starts, then marks it done; the administrator follows each step and may send a reminder.
model OrgTask {
  id             String        @id @default(cuid(2))
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeId     String
  assignee       User          @relation("OrgTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?         @relation("OrgTaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  kind           OrgTaskKind
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dueAt          DateTime
  status         OrgTaskStatus @default(assigned)
  remindedAt     DateTime?
  doneAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([assigneeId, status])
}

enum DeclaredMemberStatus {
  confirmed
  rejected
}

/// « Indique travailler chez … » (étape 3, A2, capture 078): a talent's current experience names
/// the organization. An administrator confirms it or answers « Ne travaille pas ici »; without an
/// answer the page shows « Indiqué par la personne ». Never a seat, never an access.
model OrgDeclaredMember {
  id             String               @id @default(cuid(2))
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experienceId   String
  experience     Experience           @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  status         DeclaredMemberStatus
  respondedById  String?
  respondedAt    DateTime             @default(now())

  @@unique([organizationId, experienceId])
}

/// What a person's profile and posts drew (Mon profil › Statistiques, demande d'Ephraïm du
/// 29/10/2026): one row per viewer, per day and per profile or post, so a page shown twice the
/// same day counts once. Nothing names the viewer to the owner: only totals are read.
enum AudienceKind {
  profile_visit
  post_view
  post_impression
}

model AudienceEvent {
  kind     AudienceKind
  /// The person whose profile or post it is.
  ownerId  String
  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// The profile (the owner's id) or the post.
  targetId String
  viewerId String
  day      DateTime     @db.Date

  @@id([kind, targetId, viewerId, day])
  @@index([ownerId, kind, day])
}
