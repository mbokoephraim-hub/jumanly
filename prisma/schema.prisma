// Jumanly data model (docs/specifications.md, partie 04).
// Tables are added at the step that first needs them. E1: plans and entitlements,
// organizations, skills, jobs, courses, contact messages. E2: accounts (Better Auth), memberships,
// subscriptions, payments, usage counters, overrides, audit log, first talent profile fields.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Forfaits et droits (partie 05) ─────────────────────────────
// Plans and entitlements live in the database and are edited in the admin.
// Code never tests a plan code or name, only entitlement keys (CLAUDE.md § 2).

enum PlanFamily {
  talent
  rh
  company
  partner
}

enum EntitlementType {
  boolean
  level
  limit
}

model Plan {
  id            String            @id @default(cuid(2))
  code          String            @unique
  family        PlanFamily
  name          String
  tagline       String
  /// Prefix of this plan's interface texts, e.g. "pricing.talent.pro" (features, CTA, badge).
  contentKey    String
  /// USD cents; null = on quote.
  priceCents    Int?
  currency      String            @default("USD")
  interval      String            @default("month")
  isPublic      Boolean           @default(true)
  isPurchasable Boolean           @default(true)
  recommended   Boolean           @default(false)
  sortOrder     Int
  active        Boolean           @default(true)
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]    @relation("SubscriptionPlan")
  pendingFor    Subscription[]    @relation("SubscriptionPendingPlan")
  payments      Payment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([family, sortOrder])
}

model PlanEntitlement {
  id     String          @id @default(cuid(2))
  planId String
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    String
  type   EntitlementType
  /// Text value: "true", "fundamentals", "150", "-1" (unlimited), "contract".
  value  String

  @@unique([planId, key])
  @@index([key])
}

// ─── Organisations ──────────────────────────────────────────────

enum OrganizationType {
  recruiter
  company
  partner
}

model Organization {
  id            String           @id @default(cuid(2))
  type          OrganizationType
  name          String
  slug          String           @unique
  logo          String?
  description   String?
  website       String?
  country       String?
  city          String?
  sector        String?
  size          String?
  verifiedAt    DateTime?
  parentId      String?
  parent        Organization?    @relation("OrganizationEntities", fields: [parentId], references: [id])
  entities      Organization[]   @relation("OrganizationEntities")
  jobs          Job[]
  memberships   Membership[]
  invitations   Invitation[]
  conversations Conversation[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ─── Référentiel de compétences ─────────────────────────────────

model Skill {
  id       String         @id @default(cuid(2))
  name     String
  slug     String         @unique
  aliases  String[]
  category String
  jobs     JobSkill[]
  courses  CourseSkill[]
  profiles ProfileSkill[]
}

// ─── Offres (Jobs) ──────────────────────────────────────────────

enum ContractType {
  cdi
  cdd
  stage
  mission
  freelance
  alternance
  volontariat
}

enum RemoteMode {
  onsite
  hybrid
  remote
}

enum JobStatus {
  draft
  /// Flagged by the automatic check: waiting for an administrator (partie 10 § 10.7).
  pending_review
  published
  closed
  archived
  /// Refused by moderation; the recruiter can correct and submit again.
  rejected
}

enum SkillImportance {
  required
  preferred
}

model Job {
  id                String          @id @default(cuid(2))
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  title             String
  slug              String          @unique
  description       String
  /// One item per line.
  responsibilities  String[]
  requirements      String[]
  benefits          String[]
  process           String[]
  contractType      ContractType
  city              String
  country           String
  remote            RemoteMode
  /// USD cents per month; optional.
  salaryMin         Int?
  salaryMax         Int?
  currency          String          @default("USD")
  experienceMin     Int             @default(0)
  educationLevelMin String?
  /// [{ code: "fr", level: "C1" }]
  languagesRequired Json            @default("[]")
  /// Explicit criteria set by the recruiter: ["Permis B", …]
  knockoutCriteria  Json            @default("[]")
  status            JobStatus       @default(draft)
  publishedAt       DateTime?
  closesAt          DateTime?
  createdById       String?
  createdBy         User?           @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Message sent by default when a candidate is not selected; editable each time.
  rejectionTemplate String?
  /// Automatic check results (`admin.jobs.autoFlag.*`) and the moderator's reason.
  moderationFlags   String[]
  moderationReason  String?
  skills            JobSkill[]
  stages            PipelineStage[]
  applications      Application[]
  savedBy           SavedJob[]
  matchResults      MatchResult[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, publishedAt])
}

model JobSkill {
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance
  weight     Int             @default(3)
  minLevel   Int             @default(2)

  @@id([jobId, skillId])
}

// ─── Formations (Learn) ─────────────────────────────────────────

enum CourseLevel {
  beginner
  intermediate
  advanced
}

/// Catalog level a course requires; plans grant one through `learn.catalog.level`.
enum CatalogLevel {
  free
  fundamentals
  standard
  advanced
  specialized
}

enum CourseStatus {
  draft
  review
  published
  archived
}

enum LessonKind {
  video
  text
  exercise
  quiz
  resource
}

model Course {
  id                 String         @id @default(cuid(2))
  slug               String         @unique
  title              String
  summary            String
  description        String
  objectives         String[]
  audience           String
  category           String
  level              CourseLevel
  language           String         @default("fr")
  durationMinutes    Int
  coverUrl           String?
  requiredLevel      CatalogLevel
  status             CourseStatus   @default(draft)
  certificateEnabled Boolean        @default(true)
  instructor         String?
  prerequisites      String?
  enrollmentCount    Int            @default(0)
  publishedAt        DateTime?
  modules            CourseModule[]
  skills             CourseSkill[]
  enrollments        Enrollment[]
  savedBy            SavedCourse[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, publishedAt])
}

model CourseModule {
  id       String   @id @default(cuid(2))
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  lessons  Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String       @id @default(cuid(2))
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  kind        LessonKind
  videoId     String?
  durationSec Int          @default(0)
  content     Json?
  /// Visible without an account.
  isPreview   Boolean      @default(false)
  /// [{ title, url, type, sizeKb }]: files to download (PDF supports…).
  resources   Json         @default("[]")
  transcript  String?
  quiz        Quiz?
  notes       LessonNote[]

  @@unique([moduleId, order])
}

enum QuestionType {
  single
  multiple
  text
}

/// The evaluation of a lesson of kind `quiz`.
model Quiz {
  id           String        @id @default(cuid(2))
  lessonId     String        @unique
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passingScore Int           @default(70)
  /// 0 = unlimited.
  maxAttempts  Int           @default(0)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id          String       @id @default(cuid(2))
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order       Int
  type        QuestionType
  prompt      String
  options     String[]
  /// Indices of the right options (single, multiple) or accepted answers (text).
  answer      String[]
  explanation String?

  @@unique([quizId, order])
}

model Enrollment {
  id               String       @id @default(cuid(2))
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// 0 to 100.
  progress         Int          @default(0)
  completedLessons String[]
  lastLessonId     String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  certificate      Certificate?

  @@unique([userId, courseId])
}

model QuizAttempt {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// 0 to 100.
  score     Int
  /// { [questionId]: string[] }
  answers   Json
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, quizId])
}

/// Attestation of a finished course. Name, title and hours are copied at delivery.
model Certificate {
  id           String     @id @default(cuid(2))
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Public number, also used in the verification address (JMN-XXXX-XXXX).
  code         String     @unique
  holderName   String
  courseTitle  String
  hours        Int
  issuedAt     DateTime   @default(now())
  revokedAt    DateTime?
}

/// Private notes of a learner on a lesson.
model LessonNote {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

model SavedCourse {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
}

model CourseSkill {
  courseId     String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill  @relation(fields: [skillId], references: [id])
  levelGranted Int    @default(2)

  @@id([courseId, skillId])
}

// ─── Formulaire de contact ──────────────────────────────────────

model ContactMessage {
  id           String   @id @default(cuid(2))
  /// "contact" (form /contact) or "partners" (form /partenaires).
  audience     String
  /// Subject code from the form (account, quote, partners…).
  subject      String
  name         String
  email        String
  organization String?
  country      String?
  message      String
  /// Extra answers (quote: users, entities; partners: type, role, beneficiaries, plan, duration).
  details      Json     @default("{}")
  /// Mailbox the message was forwarded to.
  routedTo     String
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
}

// ─── Comptes (Better Auth) ──────────────────────────────────────
// Field names of User, Session, Account, Verification, TwoFactor and RateLimit follow Better Auth.

enum PlatformRole {
  user
  content_editor
  support_agent
  platform_admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id                  String                    @id @default(cuid(2))
  name                String
  email               String                    @unique
  emailVerified       Boolean                   @default(false)
  image               String?
  firstName           String?
  lastName            String?
  country             String?
  city                String?
  locale              String                    @default("fr")
  platformRole        PlatformRole              @default(user)
  status              UserStatus                @default(active)
  /// Consent to AI suggestions (CLAUDE.md § 12): date of consent, null when withdrawn.
  aiConsentAt         DateTime?
  newsletter          Boolean                   @default(false)
  termsAcceptedAt     DateTime?
  /// Account deletion requested: effective at this date unless the user signs in again.
  deletionScheduledAt DateTime?
  twoFactorEnabled    Boolean                   @default(false)
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  memberships         Membership[]
  talentProfile       TalentProfile?
  diagnostics         CareerDiagnostic[]
  savedJobs           SavedJob[]
  jobsCreated         Job[]                     @relation("JobCreator")
  notifications       Notification[]
  participations      ConversationParticipant[]
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  lessonNotes         LessonNote[]
  savedCourses        SavedCourse[]
  aiUsages            AiUsage[]
  aiSuggestions       AiSuggestion[]
  matchDisputes       MatchDispute[]                @relation("DisputeAuthor")
  progressPlan        ProgressPlan?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Appartenances (partie 05 § 5) ──────────────────────────────

enum MembershipRole {
  org_owner
  org_admin
  recruiter
  hiring_manager
  viewer
  partner_manager
}

enum MembershipStatus {
  invited
  active
  removed
}

model Membership {
  id             String           @id @default(cuid(2))
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  status         MembershipStatus @default(active)
  /// Job title given at sign-up (« Votre fonction »).
  jobTitle       String?
  invitedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─── Abonnements, paiements, quotas (parties 05, 09) ────────────

enum SubjectType {
  user
  organization
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
  sponsored
}

enum SubscriptionSource {
  self
  license
  admin
}

model Subscription {
  id                 String             @id @default(cuid(2))
  subjectType        SubjectType
  subjectId          String
  planId             String
  plan               Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Downgrade taking effect at the end of the paid period.
  pendingPlanId      String?
  pendingPlan        Plan?              @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  source             SubscriptionSource @default(self)
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([subjectType, subjectId])
}

enum PaymentMethod {
  mobile_money
  card
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  refunded
}

model Payment {
  id             String        @id @default(cuid(2))
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  /// Who pays and for which plan, kept even before the subscription exists.
  subjectType    SubjectType
  subjectId      String
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  provider       String
  method         PaymentMethod
  operator       String?
  /// Mobile Money number, masked (e.g. ••••••4521); never stored in full.
  msisdnMasked   String?
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(pending)
  providerRef    String        @unique
  idempotencyKey String        @unique
  failureReason  String?
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subjectType, subjectId])
}

/// Consumption of a quota for one period (rolling month from the subscription start).
model UsageCounter {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  periodStart DateTime
  periodEnd   DateTime
  used        Int         @default(0)

  @@unique([subjectType, subjectId, key, periodStart])
}

/// Per-subject entitlement value (commercial gesture, Premium contract).
model EntitlementOverride {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  value       String
  reason      String
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId])
}

// ─── Profil talent (début, complété en E3) ──────────────────────

enum ProfileVisibility {
  private
  recruiters
  anonymous
}

model TalentProfile {
  id                String            @id @default(cuid(2))
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String?
  summary           String?
  /// Main goal chosen on the welcome screen (firstJob, newJob, reconversion…).
  goal              String?
  targetJob         String?
  visibility        ProfileVisibility @default(private)
  availability      Availability      @default(open)
  availableFrom     DateTime?
  notice            String?
  desiredJobTitles  String[]
  /// Values of `talent.profile.preferences.contract.*` (cdi, cdd, internship…).
  desiredContracts  String[]
  desiredLocations  String[]
  remotePreferences RemoteMode[]
  relocation        Boolean           @default(false)
  /// Never shown to recruiters. Whole USD (or `salaryCurrency`) per `salaryPeriod`.
  salaryMin         Int?
  salaryCurrency    String            @default("USD")
  salaryPeriod      String            @default("month")
  sectors           String[]
  /// [{ code: "fr", level: "native" | "fluent" | …, cefr?: "B2" }]
  languages         Json              @default("[]")
  /// 0 to 100, recomputed on every profile change.
  completeness      Int               @default(0)
  /// « Calcul de compatibilité » (Paramètres > Confidentialité). Off: no score anywhere.
  matchingEnabled   Boolean           @default(true)
  matchResults      MatchResult[]
  skills            ProfileSkill[]
  experiences       Experience[]
  educations        Education[]
  documents         Document[]
  applications      Application[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

enum Availability {
  open
  listening
  not_looking
}

enum ExperienceType {
  job
  internship
  freelance
  volunteer
  entrepreneur
}

model Experience {
  id          String         @id @default(cuid(2))
  profileId   String
  profile     TalentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  company     String
  type        ExperienceType @default(job)
  location    String?
  startDate   DateTime
  /// null = current position.
  endDate     DateTime?
  /// One achievement per line.
  description String         @default("")
  createdAt   DateTime       @default(now())

  @@index([profileId])
}

enum EducationLevel {
  none
  secondary
  vocational
  bachelor
  master
  doctorate
}

model Education {
  id        String         @id @default(cuid(2))
  profileId String
  profile   TalentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  degree    String
  level     EducationLevel
  field     String?
  school    String
  startYear Int?
  /// null = in progress.
  endYear   Int?
  createdAt DateTime       @default(now())

  @@index([profileId])
}

enum DocumentKind {
  cv
  cover_letter
  bio
  portfolio_item
  other
}

/// A CV (or later a letter): structured content, rendered by a template.
model Document {
  id         String        @id @default(cuid(2))
  profileId  String
  profile    TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind       DocumentKind
  title      String
  templateId String        @default("classic")
  content    Json          @default("{}")
  isPrimary  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([profileId, kind])
}

enum DiagnosticLevel {
  simple
  personalized
}

model CareerDiagnostic {
  id        String          @id @default(cuid(2))
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     DiagnosticLevel
  answers   Json
  result    Json
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

// ─── Candidatures (Jobs, partie 04) ─────────────────────────────

enum StageKind {
  new
  screening
  test
  interview
  offer
  hired
  rejected
}

model PipelineStage {
  id           String        @id @default(cuid(2))
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  kind         StageKind
  applications Application[]

  @@unique([jobId, order])
}

enum ApplicationStatus {
  active
  withdrawn
  rejected
  hired
}

enum ApplicationSource {
  direct
  invitation
  talent_search
}

model Application {
  id           String             @id @default(cuid(2))
  jobId        String
  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId    String
  profile      TalentProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stageId      String
  stage        PipelineStage      @relation(fields: [stageId], references: [id])
  status       ApplicationStatus  @default(active)
  coverLetter  String?
  /// Copy of the CV as sent (title, template, content): later edits do not change it.
  cvSnapshot   Json?
  source       ApplicationSource  @default(direct)
  /// Score and explanation shown when the talent applied (partie 08 § 8.10), frozen.
  matchScore       Int?
  matchExplanation Json?
  viewedAt     DateTime?
  events       ApplicationEvent[]
  conversation Conversation?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([jobId, profileId])
  @@index([profileId, status])
}

model ApplicationEvent {
  id            String      @id @default(cuid(2))
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  /// submitted, stage_changed, note, message, document_requested, decision, withdrawn
  type          String
  payload       Json        @default("{}")
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model SavedJob {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

enum SkillSource {
  declared
  course
  assessment
  cv_extracted
}

model ProfileSkill {
  id        String        @id @default(cuid(2))
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill         @relation(fields: [skillId], references: [id])
  /// 1 to 4: notions, intermediate, advanced, expert.
  level     Int           @default(2)
  source    SkillSource   @default(declared)
  verified  Boolean       @default(false)
  /// certificate, experience, project, link or null.
  proof     String?
  proofUrl  String?
  createdAt DateTime      @default(now())

  @@unique([profileId, skillId])
}

// ─── Audit (partie 03 § 3.6) ────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid(2))
  actorId        String?
  action         String
  targetType     String
  targetId       String
  organizationId String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// ─── Hire et Connect (E4) ───────────────────────────────────────

model Invitation {
  id             String         @id @default(cuid(2))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole
  token          String         @unique
  invitedById    String?
  message        String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([email])
}

enum ConversationKind {
  application
  contact_request
  support
}

/// One conversation per application, between the talent and the hiring organization.
model Conversation {
  id             String                    @id @default(cuid(2))
  kind           ConversationKind
  applicationId  String?                   @unique
  application    Application?              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The talent side of the conversation.
  talentUserId   String
  /// Set when the talent blocks the organization: no more messages from it.
  blockedAt      DateTime?
  participants   ConversationParticipant[]
  messages       Message[]
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())

  @@index([organizationId, lastMessageAt])
  @@index([talentUserId, lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid(2))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

enum MessageKind {
  text
  document_request
  invitation
  system
}

model Message {
  id             String       @id @default(cuid(2))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  body           String
  kind           MessageKind  @default(text)
  /// document_request: { name, due, submittedAt?, document? } ; text with a document: { document }
  payload        Json         @default("{}")
  /// Hidden by moderation after a report.
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// newApplication, statusChange, notSelected, newMessage, documentRequest, orgInvite, jobModerated
  type      String
  payload   Json      @default("{}")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

enum ReportStatus {
  open
  in_progress
  closed
}

model Report {
  id           String       @id @default(cuid(2))
  reporterId   String
  /// job, message, conversation, profile, organization
  targetType   String
  targetId     String
  reason       String
  details      String?
  status       ReportStatus @default(open)
  resolution   String?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// ─── Jumanly Intelligence (partie 08) ───────────────────────────

/// Versioned weights of the eight criteria, edited in /admin/ia. The newest active one is used.
model MatchingWeights {
  id          String   @id @default(cuid(2))
  version     String   @unique
  /// { skills_required: 35, skills_preferred: 10, … }
  weights     Json
  activeFrom  DateTime @default(now())
  createdById String?
  note        String?
  createdAt   DateTime @default(now())
}

/// Last computed score of a profile for a job, with its explanation (cache, recomputed when stale).
model MatchResult {
  id             String        @id @default(cuid(2))
  profileId      String
  profile        TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score          Int
  band           String
  explanation    Json
  weightsVersion String
  computedAt     DateTime      @default(now())

  @@unique([profileId, jobId])
  @@index([jobId, score])
}

/// Embeddings for the semantic criterion (pgvector). Written and read with SQL.
model Embedding {
  id          String                 @id @default(cuid(2))
  /// profile or job
  subjectType String
  subjectId   String
  model       String
  contentHash String
  vector      Unsupported("vector")?
  updatedAt   DateTime               @updatedAt

  @@unique([subjectType, subjectId])
}

/// Every call to a language model (partie 03): feature, model, tokens, estimated cost.
model AiUsage {
  id             String   @id @default(cuid(2))
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  /// cv_parse, cv_coach, diagnostic, progress_plan, match_explain, hire_cv_analysis…
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicroUsd   Int      @default(0)
  planCode       String?
  /// ok, invalid (output rejected by validation), error
  status         String   @default("ok")
  createdAt      DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
}

enum SuggestionStatus {
  pending
  applied
  ignored
}

/// A suggestion of the CV coach (or the CV import): the talent applies or ignores it.
model AiSuggestion {
  id         String           @id @default(cuid(2))
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature    String
  documentId String?
  /// { section, before, after, why, kind… }
  payload    Json
  status     SuggestionStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, feature, status])
}

enum DisputeStatus {
  open
  in_review
  corrected
  confirmed
}

/// « Signaler une erreur » on a score: a person from Jumanly checks the calculation.
model MatchDispute {
  id              String        @id @default(cuid(2))
  userId          String
  user            User          @relation("DisputeAuthor", fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  applicationId   String?
  /// skill, experience, education, language, location, other
  reason          String
  details         String
  notifyRecruiter Boolean       @default(false)
  scoreBefore     Int
  scoreAfter      Int?
  status          DisputeStatus @default(open)
  resolution      String?
  resolvedById    String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// Individual progress plan (Starter and more): steps the talent can tick, edit or remove.
model ProgressPlan {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  /// [{ id, title, detail, kind: course|skill|profile|action, href?, done }]
  steps     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
