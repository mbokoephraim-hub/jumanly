// Jumanly data model (docs/specifications.md, partie 04).
// Tables are added at the step that first needs them. E1: plans and entitlements,
// organizations, skills, jobs, courses, contact messages. E2: accounts (Better Auth), memberships,
// subscriptions, payments, usage counters, overrides, audit log, first talent profile fields.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Forfaits et droits (partie 05) ─────────────────────────────
// Plans and entitlements live in the database and are edited in the admin.
// Code never tests a plan code or name, only entitlement keys (CLAUDE.md § 2).

/// Theme of the signed-in space: Clair (Crème, white cards) or Vert (Sapin to Nuit, glass cards).
enum UserTheme {
  light
  green
}

enum PlanFamily {
  talent
  rh
  company
  partner
}

enum EntitlementType {
  boolean
  level
  limit
}

model Plan {
  id             String            @id @default(cuid(2))
  code           String            @unique
  family         PlanFamily
  name           String
  tagline        String
  /// Prefix of this plan's interface texts, e.g. "pricing.talent.pro" (features, CTA, badge).
  contentKey     String
  /// USD cents; null = on quote.
  priceCents     Int?
  currency       String            @default("USD")
  interval       String            @default("month")
  isPublic       Boolean           @default(true)
  isPurchasable  Boolean           @default(true)
  recommended    Boolean           @default(false)
  sortOrder      Int
  active         Boolean           @default(true)
  entitlements   PlanEntitlement[]
  subscriptions  Subscription[]    @relation("SubscriptionPlan")
  pendingFor     Subscription[]    @relation("SubscriptionPendingPlan")
  payments       Payment[]
  licenseBatches LicenseBatch[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([family, sortOrder])
}

model PlanEntitlement {
  id     String          @id @default(cuid(2))
  planId String
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    String
  type   EntitlementType
  /// Text value: "true", "fundamentals", "150", "-1" (unlimited), "contract".
  value  String

  @@unique([planId, key])
  @@index([key])
}

// ─── Organisations ──────────────────────────────────────────────

enum OrganizationType {
  recruiter
  company
  partner
}

enum OrgVerificationStatus {
  none
  pending
  verified
  rejected
  /// The administrator asked for more (Admin v2, étape 4); back to pending when the organization answers.
  info_requested
}

model Organization {
  id                      String                 @id @default(cuid(2))
  type                    OrganizationType
  name                    String
  slug                    String                 @unique
  logo                    String?
  description             String?
  website                 String?
  country                 String?
  city                    String?
  sector                  String?
  size                    String?
  verifiedAt              DateTime?
  /// Profile fields shown on the public page (partie 07 § 4).
  legalName               String?
  /// company, consultant, ngo, public, education (`org.profile.type.*`).
  category                String?
  contactEmail            String?
  /// Verification by Jumanly (admin, E8). `verifiedAt` stays the badge's source.
  verificationStatus      OrgVerificationStatus  @default(none)
  /// { registration, taxId, domainEmail, mandate } as typed by the organization.
  verificationRequest     Json?
  verificationRequestedAt DateTime?
  verificationReason      String?
  verifiedById            String?
  parentId                String?
  parent                  Organization?          @relation("OrganizationEntities", fields: [parentId], references: [id])
  entities                Organization[]         @relation("OrganizationEntities")
  jobs                    Job[]
  memberships             Membership[]
  invitations             Invitation[]
  conversations           Conversation[]
  teams                   Team[]
  orgEntities             OrgEntity[]
  talentPools             TalentPool[]
  contactRequests         ContactRequest[]
  contactBlocks           ContactBlock[]
  interviews              Interview[]
  messageTemplates        MessageTemplate[]
  /// Partner organizations only (E9): bank, university, foundation, company, cooperation, public.
  partnerKind             String?
  licenseBatches          LicenseBatch[]
  /// Supporting documents of the verification request (Admin v2, étape 4).
  documents               OrganizationDocument[]
  /// Suspended by a Jumanly administrator: jobs hidden, Hire closed to its members.
  suspendedAt             DateTime?
  suspensionReason        String?
  /// Jobs that were live when the organization was suspended, published again on reactivation.
  suspendedJobIds         String[]               @default([])
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

/// A supporting document (PDF or image) sent with a verification request. The bytes live in the
/// file storage (`src/server/storage`), under `storageKey`.
model OrganizationDocument {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageKey     String       @unique
  name           String
  contentType    String
  size           Int
  uploadedById   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Files kept in the database by the default storage driver (no S3 configured).
model StoredFile {
  key         String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// ─── Référentiel de compétences ─────────────────────────────────

model Skill {
  id       String         @id @default(cuid(2))
  name     String
  slug     String         @unique
  aliases  String[]
  category String
  jobs     JobSkill[]
  courses  CourseSkill[]
  profiles ProfileSkill[]
}

// ─── Offres (Jobs) ──────────────────────────────────────────────

enum ContractType {
  cdi
  cdd
  stage
  mission
  freelance
  alternance
  volontariat
}

enum RemoteMode {
  onsite
  hybrid
  remote
}

enum JobStatus {
  draft
  /// Flagged by the automatic check: waiting for an administrator (partie 10 § 10.7).
  pending_review
  published
  closed
  archived
  /// Refused by moderation; the recruiter can correct and submit again.
  rejected
  /// Sent back by moderation with the points to correct; resubmitted, it goes back to review.
  changes_requested
}

enum SkillImportance {
  required
  preferred
}

model Job {
  id                String             @id @default(cuid(2))
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  title             String
  slug              String             @unique
  description       String
  /// One item per line.
  responsibilities  String[]
  requirements      String[]
  benefits          String[]
  process           String[]
  contractType      ContractType
  city              String
  country           String
  remote            RemoteMode
  /// USD cents per month; optional.
  salaryMin         Int?
  salaryMax         Int?
  currency          String             @default("USD")
  experienceMin     Int                @default(0)
  educationLevelMin String?
  /// [{ code: "fr", level: "C1" }]
  languagesRequired Json               @default("[]")
  /// Explicit criteria set by the recruiter: ["Permis B", …]
  knockoutCriteria  Json               @default("[]")
  status            JobStatus          @default(draft)
  publishedAt       DateTime?
  /// Set when the end of a paid plan put this offer back in draft (partie 09 § 9.2); restored
  /// automatically when the organization pays again, within its limit.
  pausedByBillingAt DateTime?
  closesAt          DateTime?
  createdById       String?
  createdBy         User?              @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Recruiter in charge (« attribution des offres », partie 05 § 2.3).
  assignedToId      String?
  assignedTo        User?              @relation("JobAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  teamId            String?
  team              Team?              @relation("JobTeam", fields: [teamId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Team?              @relation("JobDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  entityId          String?
  entity            OrgEntity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  /// Scorecard template: [{ name, description }] (`hire.scorecards`).
  scorecardTemplate Json               @default("[]")
  /// Members given access to this job only (hiring managers, per-job permissions).
  assignments       JobAssignment[]
  contactRequests   ContactRequest[]
  /// Message sent by default when a candidate is not selected; editable each time.
  rejectionTemplate String?
  /// Automatic check results (`admin.jobs.autoFlag.*`) and the moderator's reason.
  moderationFlags   String[]
  moderationReason  String?
  /// Points to correct ticked by the moderator (`admin.jobs.fix.*`), with `changes_requested`.
  moderationChecks  String[]           @default([])
  skills            JobSkill[]
  stages            PipelineStage[]
  applications      Application[]
  savedBy           SavedJob[]
  applicationDrafts ApplicationDraft[]
  matchResults      MatchResult[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, publishedAt])
}

model JobSkill {
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance
  weight     Int             @default(3)
  minLevel   Int             @default(2)

  @@id([jobId, skillId])
}

// ─── Formations (Learn) ─────────────────────────────────────────

enum CourseLevel {
  beginner
  intermediate
  advanced
}

/// Catalog level a course requires; plans grant one through `learn.catalog.level`.
enum CatalogLevel {
  free
  fundamentals
  standard
  advanced
  specialized
}

/// Editorial line of a course (Learn v2, étape 1): who stands behind its content.
enum EditorialLine {
  originals
  expert_series
  partner_programs
}

/// A domain of the catalog (Learn v2, étape 1): Career & Employability, AI & Digital Tools…
/// Created by the migration, edited in the admin; a course belongs to one domain at most.
model LearningDomain {
  id          String         @id @default(cuid(2))
  slug        String         @unique
  name        String
  description String         @default("")
  /// Name of a brand icon (`Icon`), chosen in the admin.
  icon        String         @default("learn")
  order       Int            @default(0)
  courses     Course[]
  paths       LearningPath[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([order])
}

/// Learn v2, étape 2: a path is an ordered series of courses (Domaine → Parcours → Formation).
/// A course keeps its own access level; the path adds no access of its own.
model LearningPath {
  id            String               @id @default(cuid(2))
  slug          String               @unique
  title         String
  summary       String               @default("")
  domainId      String?
  domain        LearningDomain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  editorialLine EditorialLine        @default(originals)
  status        CourseStatus         @default(draft)
  publishedAt   DateTime?
  courses       LearningPathCourse[]
  followers     LearningPathFollow[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, domainId])
}

model LearningPathCourse {
  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int

  @@id([pathId, courseId])
  @@index([courseId])
}

/// A learner who follows a path (« Mes parcours »). Progress comes from the course enrollments.
model LearningPathFollow {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId    String
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  startedAt DateTime     @default(now())

  @@id([userId, pathId])
  @@index([pathId])
}

/// Learn v2, étape 3: where a learner stopped in a lesson video, to resume at the second.
/// Completion stays in `Enrollment.completedLessons`; this table only keeps the position.
model LessonProgress {
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  positionSeconds Int      @default(0)
  durationSeconds Int?
  updatedAt       DateTime @updatedAt

  @@id([userId, lessonId])
  @@index([lessonId])
}

enum CourseStatus {
  draft
  review
  published
  archived
}

enum LessonKind {
  video
  text
  exercise
  quiz
  resource
}

model Course {
  id                 String               @id @default(cuid(2))
  slug               String               @unique
  title              String
  summary            String
  description        String
  objectives         String[]
  audience           String
  category           String
  /// Domain of the catalog (Learn v2); null until the team files the course.
  domainId           String?
  domain             LearningDomain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  editorialLine      EditorialLine        @default(originals)
  level              CourseLevel
  language           String               @default("fr")
  durationMinutes    Int
  coverUrl           String?
  requiredLevel      CatalogLevel
  /// Job families of the course's job-specific exercises (`learn.exercises.job_specific`).
  jobFamilies        String[]             @default([])
  status             CourseStatus         @default(draft)
  certificateEnabled Boolean              @default(true)
  instructor         String?
  prerequisites      String?
  enrollmentCount    Int                  @default(0)
  publishedAt        DateTime?
  modules            CourseModule[]
  skills             CourseSkill[]
  enrollments        Enrollment[]
  savedBy            SavedCourse[]
  inPaths            LearningPathCourse[]
  documents          CourseDocument[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, publishedAt])
  @@index([domainId])
}

model CourseModule {
  id       String   @id @default(cuid(2))
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  lessons  Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String           @id @default(cuid(2))
  moduleId    String
  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  kind        LessonKind
  videoId     String?
  durationSec Int              @default(0)
  content     Json?
  /// Visible without an account.
  isPreview   Boolean          @default(false)
  /// Job-specific exercise (`learn.exercises.job_specific`): optional, not counted in progress.
  jobSpecific Boolean          @default(false)
  /// [{ title, url, type, sizeKb }]: files to download (PDF supports…).
  resources   Json             @default("[]")
  transcript  String?
  quiz        Quiz?
  notes       LessonNote[]
  progress    LessonProgress[]
  documents   CourseDocument[]

  @@unique([moduleId, order])
}

// ─── Documents PDF des formations (Admin v3, étape 5) ──────────────
// Files live in the private storage (never under `public/`), downloaded through a route that
// checks the visibility, the enrollment, the catalog level and `learn.resources.specialized`.

enum CourseDocumentKind {
  support
  exercises
  reading
  template
  answer_key
  other
}

enum CourseDocumentVisibility {
  /// On the public course page, for everyone.
  public
  /// Enrolled talents whose plan opens the course.
  enrolled
  /// The Jumanly team only (an answer key always is).
  team
}

model CourseDocument {
  id          String                   @id @default(cuid(2))
  courseId    String
  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Attached to one lesson; null = the whole course. A deleted lesson leaves it on the course.
  lessonId    String?
  lesson      Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  kind        CourseDocumentKind
  visibility  CourseDocumentVisibility @default(enrolled)
  /// Reserved to accounts with `learn.resources.specialized`.
  specialized Boolean                  @default(false)
  storageKey  String                   @unique
  size        Int
  pages       Int
  order       Int
  downloads   Int                      @default(0)
  /// Who sent the file (kept as an id: the audit log has the details).
  authorId    String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([courseId, order])
}

enum QuestionType {
  single
  multiple
  text
}

/// The evaluation of a lesson of kind `quiz`.
model Quiz {
  id           String        @id @default(cuid(2))
  lessonId     String        @unique
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passingScore Int           @default(70)
  /// 0 = unlimited.
  maxAttempts  Int           @default(0)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id          String       @id @default(cuid(2))
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order       Int
  type        QuestionType
  prompt      String
  options     String[]
  /// Indices of the right options (single, multiple) or accepted answers (text).
  answer      String[]
  explanation String?

  @@unique([quizId, order])
}

model Enrollment {
  id               String       @id @default(cuid(2))
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// 0 to 100.
  progress         Int          @default(0)
  completedLessons String[]
  lastLessonId     String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  certificate      Certificate?

  @@unique([userId, courseId])
}

model QuizAttempt {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// 0 to 100.
  score     Int
  /// { [questionId]: string[] }
  answers   Json
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, quizId])
}

/// Attestation of a finished course. Name, title and hours are copied at delivery.
model Certificate {
  id           String     @id @default(cuid(2))
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Public number, also used in the verification address (JMN-XXXX-XXXX).
  code         String     @unique
  holderName   String
  courseTitle  String
  hours        Int
  issuedAt     DateTime   @default(now())
  revokedAt    DateTime?
}

/// Private notes of a learner on a lesson.
model LessonNote {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

model SavedCourse {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
}

model CourseSkill {
  courseId     String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill  @relation(fields: [skillId], references: [id])
  levelGranted Int    @default(2)

  @@id([courseId, skillId])
}

// ─── Formulaire de contact ──────────────────────────────────────

model ContactMessage {
  id           String   @id @default(cuid(2))
  /// "contact" (form /contact) or "partners" (form /partenaires).
  audience     String
  /// Subject code from the form (account, quote, partners…).
  subject      String
  name         String
  email        String
  organization String?
  country      String?
  message      String
  /// Extra answers (quote: users, entities; partners: type, role, beneficiaries, plan, duration).
  details      Json     @default("{}")
  /// Mailbox the message was forwarded to.
  routedTo     String
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
}

// ─── Comptes (Better Auth) ──────────────────────────────────────
// Field names of User, Session, Account, Verification, TwoFactor and RateLimit follow Better Auth.

enum PlatformRole {
  user
  content_editor
  support_agent
  platform_admin
}

enum UserStatus {
  active
  suspended
  /// Account deleted and anonymized (partie 10): kept only so applications and payments stay whole.
  deleted
}

model User {
  id                  String                    @id @default(cuid(2))
  name                String
  email               String                    @unique
  emailVerified       Boolean                   @default(false)
  image               String?
  firstName           String?
  lastName            String?
  country             String?
  city                String?
  locale              String                    @default("fr")
  platformRole        PlatformRole              @default(user)
  status              UserStatus                @default(active)
  /// Consent to AI suggestions (CLAUDE.md § 12): date of consent, null when withdrawn.
  aiConsentAt         DateTime?
  newsletter          Boolean                   @default(false)
  /// « Réduire les animations » (docs/experience-animee § 0.4): no motion in the signed-in space.
  reduceMotion        Boolean                   @default(false)
  /// Theme of the signed-in space (docs/ux-mobile-talent V6 § B7): light (Crème) or green.
  theme               UserTheme                 @default(light)
  /// Full welcome intro seen (docs/refonte-connexion § 7): played once per account, on any device.
  introSeenAt         DateTime?
  termsAcceptedAt     DateTime?
  /// Account deletion requested: effective at this date unless the user signs in again.
  deletionScheduledAt DateTime?
  twoFactorEnabled    Boolean                   @default(false)
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  memberships         Membership[]
  talentProfile       TalentProfile?
  diagnostics         CareerDiagnostic[]
  diagnosticDraft     CareerDiagnosticDraft?
  profilePhoto        ProfilePhoto?
  savedJobs           SavedJob[]
  applicationDrafts   ApplicationDraft[]
  jobsCreated         Job[]                     @relation("JobCreator")
  jobsAssigned        Job[]                     @relation("JobAssignee")
  jobAssignments      JobAssignment[]
  scorecards          Scorecard[]
  talentPools         TalentPool[]
  contactRequestsSent ContactRequest[]
  interviewsOrganized Interview[]
  notifications       Notification[]
  participations      ConversationParticipant[]
  enrollments         Enrollment[]
  learningPaths       LearningPathFollow[]
  quizAttempts        QuizAttempt[]
  lessonNotes         LessonNote[]
  lessonProgress      LessonProgress[]
  savedCourses        SavedCourse[]
  aiUsages            AiUsage[]
  aiSuggestions       AiSuggestion[]
  matchDisputes       MatchDispute[]            @relation("DisputeAuthor")
  progressPlan        ProgressPlan?
  licenses            License[]
  interviewSessions   InterviewSession[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Appartenances (partie 05 § 5) ──────────────────────────────

enum MembershipRole {
  org_owner
  org_admin
  recruiter
  hiring_manager
  viewer
  partner_manager
}

enum MembershipStatus {
  invited
  active
  removed
  /// Beyond the seats of the free plan after a paid plan ended: no access, nothing deleted.
  suspended
}

model Membership {
  id             String           @id @default(cuid(2))
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  status         MembershipStatus @default(active)
  /// Job title given at sign-up (« Votre fonction »).
  jobTitle       String?
  /// Team scope (`org.permissions.level` advanced): a recruiter then sees their team's jobs.
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─── Abonnements, paiements, quotas (parties 05, 09) ────────────

enum SubjectType {
  user
  organization
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
  sponsored
}

enum SubscriptionSource {
  self
  license
  admin
}

model Subscription {
  id                 String             @id @default(cuid(2))
  subjectType        SubjectType
  subjectId          String
  planId             String
  plan               Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Downgrade taking effect at the end of the paid period.
  pendingPlanId      String?
  pendingPlan        Plan?              @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  source             SubscriptionSource @default(self)
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([subjectType, subjectId])
}

enum PaymentMethod {
  mobile_money
  card
  /// Recorded by an administrator (Admin v2, étape 5): bank transfer or cash.
  bank_transfer
  cash
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  refunded
}

model Payment {
  id              String        @id @default(cuid(2))
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  /// Who pays and for which plan, kept even before the subscription exists.
  subjectType     SubjectType
  subjectId       String
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  provider        String
  method          PaymentMethod
  operator        String?
  /// Mobile Money number, masked (e.g. ••••••4521); never stored in full.
  msisdnMasked    String?
  amountCents     Int
  currency        String        @default("USD")
  status          PaymentStatus @default(pending)
  providerRef     String        @unique
  idempotencyKey  String        @unique
  failureReason   String?
  /// new, renewal, upgrade (partie 09 § 9.2), for the revenue indicators.
  kind            String        @default("new")
  /// Credit for the unused time of the previous plan, already deducted from amountCents.
  creditCents     Int           @default(0)
  /// Who started the payment (receipt and invoice e-mails).
  payerId         String?
  refundedAt      DateTime?
  refundReference String?
  refundedById    String?
  invoice         Invoice?
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subjectType, subjectId])
}

/// Consumption of a quota for one period (rolling month from the subscription start).
model UsageCounter {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  periodStart DateTime
  periodEnd   DateTime
  used        Int         @default(0)

  @@unique([subjectType, subjectId, key, periodStart])
}

/// Per-subject entitlement value (commercial gesture, Premium contract).
model EntitlementOverride {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  value       String
  reason      String
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId])
}

// ─── Profil talent (début, complété en E3) ──────────────────────

enum ProfileVisibility {
  private
  recruiters
  anonymous
}

model TalentProfile {
  id                     String            @id @default(cuid(2))
  userId                 String            @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  summary                String?
  /// Main goal chosen on the welcome screen (firstJob, newJob, reconversion…).
  goal                   String?
  targetJob              String?
  visibility             ProfileVisibility @default(private)
  availability           Availability      @default(open)
  availableFrom          DateTime?
  notice                 String?
  desiredJobTitles       String[]
  /// Values of `talent.profile.preferences.contract.*` (cdi, cdd, internship…).
  desiredContracts       String[]
  desiredLocations       String[]
  /// ISO 3166-1 codes of the countries where the person wants to work (screen 82). A country
  /// without any of its places in `desiredLocations` means « Tout le pays ».
  desiredCountries       String[]          @default([])
  remotePreferences      RemoteMode[]
  relocation             Boolean           @default(false)
  /// Never shown to recruiters. Whole USD (or `salaryCurrency`) per `salaryPeriod`.
  salaryMin              Int?
  salaryCurrency         String            @default("USD")
  salaryPeriod           String            @default("month")
  sectors                String[]
  /// [{ code: "fr", level: "native" | "fluent" | …, cefr?: "B2" }]
  languages              Json              @default("[]")
  /// 0 to 100, recomputed on every profile change.
  completeness           Int               @default(0)
  /// « Calcul de compatibilité » (Paramètres > Confidentialité). Off: no score anywhere.
  matchingEnabled        Boolean           @default(true)
  /// « Recevoir des demandes de mise en relation » (Paramètres > Confidentialité).
  acceptsContactRequests Boolean           @default(true)
  matchResults           MatchResult[]
  poolEntries            TalentPoolEntry[]
  contactRequests        ContactRequest[]
  skills                 ProfileSkill[]
  experiences            Experience[]
  educations             Education[]
  documents              Document[]
  applications           Application[]
  /// Public portfolio (`career.portfolio.level`), at /portfolio/[slug] when published.
  portfolioSlug          String?           @unique
  portfolioPublic        Boolean           @default(false)
  portfolioIntro         String?
  /// classic | grid (the enriched level unlocks grid and the cover colour)
  portfolioLayout        String            @default("classic")
  portfolioAccent        String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

enum Availability {
  open
  listening
  not_looking
}

enum ExperienceType {
  job
  internship
  freelance
  volunteer
  entrepreneur
}

model Experience {
  id          String         @id @default(cuid(2))
  profileId   String
  profile     TalentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  company     String
  type        ExperienceType @default(job)
  location    String?
  startDate   DateTime
  /// null = current position.
  endDate     DateTime?
  /// One achievement per line.
  description String         @default("")
  createdAt   DateTime       @default(now())

  @@index([profileId])
}

enum EducationLevel {
  none
  secondary
  vocational
  bachelor
  master
  doctorate
}

model Education {
  id        String         @id @default(cuid(2))
  profileId String
  profile   TalentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  degree    String
  level     EducationLevel
  field     String?
  school    String
  startYear Int?
  /// null = in progress.
  endYear   Int?
  createdAt DateTime       @default(now())

  @@index([profileId])
}

enum DocumentKind {
  cv
  cover_letter
  bio
  portfolio_item
  other
}

/// A CV (or later a letter): structured content, rendered by a template.
model Document {
  id         String        @id @default(cuid(2))
  profileId  String
  profile    TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind       DocumentKind
  title      String
  templateId String        @default("classique")
  content    Json          @default("{}")
  /// CV settings (accent, font, density, photo, titles language, order, page breaks):
  /// docs/modeles-cv/SPECIFICATION-MODELES-CV.md § 5.3. Null = the template's defaults.
  style      Json?
  /// Pages counted at the last export.
  pageCount  Int?
  isPrimary  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([profileId, kind])
}

enum DiagnosticLevel {
  simple
  personalized
}

model CareerDiagnostic {
  id         String          @id @default(cuid(2))
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      DiagnosticLevel
  answers    Json
  result     Json
  /// « Refaire dans 30 jours »: a notification is sent at this date (hourly job).
  remindAt   DateTime?
  remindedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([remindAt])
}

/// Answers of a diagnostic in progress, saved at each answer so the talent can resume it.
model CareerDiagnosticDraft {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  /// Index of the screen the talent was on.
  step      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Candidatures (Jobs, partie 04) ─────────────────────────────

enum StageKind {
  new
  screening
  test
  interview
  offer
  hired
  rejected
}

model PipelineStage {
  id           String        @id @default(cuid(2))
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  kind         StageKind
  applications Application[]

  @@unique([jobId, order])
}

enum ApplicationStatus {
  active
  withdrawn
  rejected
  hired
}

enum ApplicationSource {
  direct
  invitation
  talent_search
}

model Application {
  id               String             @id @default(cuid(2))
  jobId            String
  job              Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId        String
  profile          TalentProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stageId          String
  stage            PipelineStage      @relation(fields: [stageId], references: [id])
  status           ApplicationStatus  @default(active)
  coverLetter      String?
  /// Copy of the CV as sent (title, template, content): later edits do not change it.
  cvSnapshot       Json?
  source           ApplicationSource  @default(direct)
  /// Score and explanation shown when the talent applied (partie 08 § 8.10), frozen.
  matchScore       Int?
  matchExplanation Json?
  viewedAt         DateTime?
  events           ApplicationEvent[]
  conversation     Conversation?
  scorecards       Scorecard[]
  interviews       Interview[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([jobId, profileId])
  @@index([profileId, status])
}

model ApplicationEvent {
  id            String      @id @default(cuid(2))
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  /// submitted, stage_changed, note, message, document_requested, decision, withdrawn
  type          String
  payload       Json        @default("{}")
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model SavedJob {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

/// Application in progress (docs/ux-mobile-talent, prompt 4): saved at each step of the staged
/// form, removed when the application is sent. Never seen by the organization.
model ApplicationDraft {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Last step reached: cv | lettre | verification.
  step         String   @default("cv")
  /// Chosen CV; null with `profileOnly` = « Mon profil Jumanly seul », null alone = not chosen yet.
  cvDocumentId String?
  profileOnly  Boolean  @default(false)
  coverLetter  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, jobId])
  @@index([jobId])
}

enum SkillSource {
  declared
  course
  assessment
  cv_extracted
}

model ProfileSkill {
  id        String        @id @default(cuid(2))
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill         @relation(fields: [skillId], references: [id])
  /// 1 to 4: notions, intermediate, advanced, expert.
  level     Int           @default(2)
  source    SkillSource   @default(declared)
  verified  Boolean       @default(false)
  /// certificate, experience, project, link or null.
  proof     String?
  proofUrl  String?
  createdAt DateTime      @default(now())

  @@unique([profileId, skillId])
}

// ─── Contenus éditables (partie 04, /admin/contenus) ─────────────

/// A text edited in the admin that replaces the one from textes/ (FAQ), or a banner. An empty
/// value hides a FAQ question; no row means the original text.
model ContentBlock {
  id          String   @id @default(cuid(2))
  key         String
  locale      String   @default("fr")
  value       String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
}

/// The previous version of an editable content (Admin v2, étape 8), kept at each change so that
/// « Restaurer » can put it back. `item` names the content (`faq.talents.q3`, `banner.<id>`,
/// `tips.<id>`); `previous` maps each of its keys to its former value, null when it had none
/// (the original text of textes/ applied).
model ContentVersion {
  id          String   @id @default(cuid(2))
  item        String
  locale      String   @default("fr")
  previous    Json
  /// Why it changed (the reason given with the change).
  reason      String?
  /// content.faq.save, content.banner.delete, content.restore…
  action      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([item, locale, createdAt])
}

/// Kinds of running costs entered by an administrator (Admin v2, étape 2).
enum PlatformCostCategory {
  acquisition
  hosting
  ai_external
  other
}

/// A running cost of one month, entered in /admin/indicateurs/couts: the indicators derive the
/// acquisition cost, the cost per active user and the gross margin from these rows.
model PlatformCost {
  id          String               @id @default(cuid(2))
  /// First day of the month (UTC).
  month       DateTime
  category    PlatformCostCategory
  amountCents Int
  note        String?
  updatedById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([month, category])
}

// ─── Audit (partie 03 § 3.6) ────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid(2))
  actorId        String?
  action         String
  targetType     String
  targetId       String
  organizationId String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// ─── Hire et Connect (E4) ───────────────────────────────────────

model Invitation {
  id             String         @id @default(cuid(2))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole
  teamId         String?
  token          String         @unique
  invitedById    String?
  message        String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([email])
}

enum ConversationKind {
  application
  contact_request
  support
}

/// One conversation per application, between the talent and the hiring organization.
model Conversation {
  id             String                    @id @default(cuid(2))
  kind           ConversationKind
  applicationId  String?                   @unique
  application    Application?              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The talent side of the conversation.
  talentUserId   String
  contactRequest ContactRequest?
  /// Set when the talent blocks the organization: no more messages from it.
  blockedAt      DateTime?
  participants   ConversationParticipant[]
  messages       Message[]
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())

  @@index([organizationId, lastMessageAt])
  @@index([talentUserId, lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid(2))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

enum MessageKind {
  text
  document_request
  invitation
  system
  /// A file sent by its owner (CV, letter, document): payload { document }.
  file
  /// A time suggested in the conversation: payload { startsAt, timezone, durationMinutes }.
  slot
  /// A recruitment decision (rejected or hired), shown as a DecisionCard, never as a bubble.
  decision
}

model Message {
  id             String       @id @default(cuid(2))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  body           String
  kind           MessageKind  @default(text)
  /// document_request: { name, due, submittedAt?, document? } ; text with a document: { document }
  payload        Json         @default("{}")
  /// Hidden by moderation after a report.
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// newApplication, statusChange, notSelected, newMessage, documentRequest, orgInvite, jobModerated
  type      String
  payload   Json      @default("{}")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

enum ReportStatus {
  open
  in_progress
  closed
}

model Report {
  id               String       @id @default(cuid(2))
  reporterId       String
  /// job, message, conversation, profile, organization
  targetType       String
  targetId         String
  reason           String
  details          String?
  status           ReportStatus @default(open)
  /// dismiss, hide, warn: always closed with a decision and a reason.
  resolution       String?
  resolutionReason String?
  resolvedById     String?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// ─── Jumanly Intelligence (partie 08) ───────────────────────────

/// Versioned weights of the eight criteria, edited in /admin/ia. The newest active one is used.
model MatchingWeights {
  id          String   @id @default(cuid(2))
  version     String   @unique
  /// { skills_required: 35, skills_preferred: 10, … }
  weights     Json
  activeFrom  DateTime @default(now())
  createdById String?
  note        String?
  createdAt   DateTime @default(now())
}

/// Last computed score of a profile for a job, with its explanation (cache, recomputed when stale).
model MatchResult {
  id             String        @id @default(cuid(2))
  profileId      String
  profile        TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score          Int
  band           String
  explanation    Json
  weightsVersion String
  computedAt     DateTime      @default(now())

  @@unique([profileId, jobId])
  @@index([jobId, score])
}

/// Embeddings for the semantic criterion (pgvector). Written and read with SQL.
model Embedding {
  id          String                 @id @default(cuid(2))
  /// profile or job
  subjectType String
  subjectId   String
  model       String
  contentHash String
  vector      Unsupported("vector")?
  updatedAt   DateTime               @updatedAt

  @@unique([subjectType, subjectId])
}

/// Every call to a language model (partie 03): feature, model, tokens, estimated cost.
model AiUsage {
  id             String   @id @default(cuid(2))
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  /// cv_parse, cv_coach, diagnostic, progress_plan, match_explain, hire_cv_analysis…
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicroUsd   Int      @default(0)
  planCode       String?
  /// ok, invalid (output rejected by validation), error
  status         String   @default("ok")
  createdAt      DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
}

enum SuggestionStatus {
  pending
  applied
  ignored
}

/// A suggestion of the CV coach (or the CV import): the talent applies or ignores it.
model AiSuggestion {
  id         String           @id @default(cuid(2))
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature    String
  documentId String?
  /// { section, before, after, why, kind… }
  payload    Json
  status     SuggestionStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, feature, status])
}

enum DisputeStatus {
  open
  in_review
  corrected
  confirmed
}

/// « Signaler une erreur » on a score: a person from Jumanly checks the calculation.
model MatchDispute {
  id              String        @id @default(cuid(2))
  userId          String
  user            User          @relation("DisputeAuthor", fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  applicationId   String?
  /// skill, experience, education, language, location, other
  reason          String
  details         String
  notifyRecruiter Boolean       @default(false)
  scoreBefore     Int
  scoreAfter      Int?
  status          DisputeStatus @default(open)
  resolution      String?
  resolvedById    String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// Individual progress plan (Starter and more): steps the talent can tick, edit or remove.
model ProgressPlan {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  /// [{ id, title, detail, kind: course|skill|profile|action, href?, done }]
  steps     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InterviewSimMode {
  text
  voice
}

enum InterviewSimStatus {
  active
  completed
}

/// An interview simulation (E10, partie 08 § 8.9): questions, answers, structured feedback.
/// Never a hireability score: the feedback names strengths and points to work on.
model InterviewSession {
  id              String             @id @default(cuid(2))
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            InterviewSimMode   @default(text)
  /// general | technical | behavioral | motivation
  type            String
  /// junior | intermediate | senior
  level           String
  jobTitle        String
  jobId           String?
  durationMinutes Int
  /// [{ question, answer, durationSec? }]
  questions       Json               @default("[]")
  /// { summary, criteria: [{ key, level, comment }], strengths[], improvements[], perQuestion[] }
  feedback        Json?
  status          InterviewSimStatus @default(active)
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
}

/// A signed webhook received from a payment provider, stored before processing (partie 09 § 9.4).
/// The unique (provider, eventId) makes a replayed webhook a no-op.
model PaymentEvent {
  id          String    @id @default(cuid(2))
  provider    String
  eventId     String
  providerRef String
  status      String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([providerRef])
}

/// Invoice of a successful payment: sequential number, what was billed, frozen at issue.
model Invoice {
  id            String      @id @default(cuid(2))
  /// JMN-2026-000001
  number        String      @unique
  sequence      Int         @unique
  paymentId     String      @unique
  payment       Payment     @relation(fields: [paymentId], references: [id])
  subjectType   SubjectType
  subjectId     String
  billedName    String
  billedEmail   String
  billedAddress String?
  billedTaxId   String?
  planName      String
  amountCents   Int
  creditCents   Int         @default(0)
  currency      String      @default("USD")
  periodStart   DateTime
  periodEnd     DateTime
  issuedAt      DateTime    @default(now())

  @@index([subjectType, subjectId])
}

/// What appears on the invoices of a user or an organization (« Informations de facturation »).
model BillingDetails {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  name        String
  address     String?
  taxId       String?
  email       String?
  updatedAt   DateTime    @updatedAt

  @@unique([subjectType, subjectId])
}

/// Idempotency keys of background tasks (reminders, grace, return to free): one row per action done.
model JobRun {
  key   String   @id
  ranAt DateTime @default(now())
}

// ─── Hire avancé et Companies (E8) ──────────────────────────────

enum TeamKind {
  team
  department
}

/// A recruiting team or a department of an organization (`org.teams`).
model Team {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           TeamKind     @default(team)
  leadId         String?
  entityId       String?
  entity         OrgEntity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  jobs           Job[]        @relation("JobTeam")
  departmentJobs Job[]        @relation("JobDepartment")
  pools          TalentPool[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind])
}

/// An entity or subsidiary inside an organization (`org.entities`).
model OrgEntity {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  country        String?
  parentId       String?
  parent         OrgEntity?   @relation("OrgEntityTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrgEntity[]  @relation("OrgEntityTree")
  verifiedAt     DateTime?
  teams          Team[]
  jobs           Job[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// A member given access to one job (per-job permissions, hiring managers).
model JobAssignment {
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, userId])
  @@index([userId])
}

enum ScorecardRecommendation {
  strong_yes
  yes
  no
  strong_no
}

/// One evaluation per reviewer and application (`hire.scorecards`).
model Scorecard {
  id             String                  @id @default(cuid(2))
  applicationId  String
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User                    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  /// [{ name, rating 1-5, comment }]
  ratings        Json                    @default("[]")
  recommendation ScorecardRecommendation
  comment        String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([applicationId, reviewerId])
}

enum PoolVisibility {
  private
  team
  org
}

model TalentPool {
  id             String            @id @default(cuid(2))
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  visibility     PoolVisibility    @default(private)
  ownerId        String?
  owner          User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  entries        TalentPoolEntry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

model TalentPoolEntry {
  poolId    String
  pool      TalentPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  addedById String?
  note      String?
  createdAt DateTime      @default(now())

  @@id([poolId, profileId])
}

enum ContactRequestStatus {
  pending
  accepted
  declined
  expired
}

/// A recruiter asks a visible talent for a conversation; nothing is exchanged before consent.
model ContactRequest {
  id             String               @id @default(cuid(2))
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  profileId      String
  profile        TalentProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  message        String
  status         ContactRequestStatus @default(pending)
  expiresAt      DateTime
  respondedAt    DateTime?
  conversationId String?              @unique
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([profileId, status])
  @@index([organizationId, createdAt])
}

/// « Ne plus recevoir de demandes de {company} ».
model ContactBlock {
  profileId      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([profileId, organizationId])
}

enum InterviewMode {
  video
  onsite
  audio
}

enum InterviewStatus {
  pending
  confirmed
  reschedule
  declined
  canceled
  done
  no_show
}

enum MessageTemplateKind {
  convocation
  document
  relance
  acceptation
  refus
}

/// A message template of an organization (prompt 5): always read and written with its organizationId.
model MessageTemplate {
  id             String              @id @default(cuid(2))
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           MessageTemplateKind
  title          String
  body           String
  updatedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, kind])
}

/// An interview invitation (`connect.appointments`): the recruiter proposes slots, the talent picks.
model Interview {
  id              String          @id @default(cuid(2))
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizerId     String
  organizer       User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  mode            InterviewMode
  durationMinutes Int
  /// Proposed by the recruiter (1 to 3).
  slots           DateTime[]
  /// Proposed back by the talent when asking for another time.
  proposedSlots   DateTime[]
  startsAt        DateTime?
  /// IANA time zone the slots were written in.
  timezone        String
  link            String?
  address         String?
  message         String?
  /// Members of the team who take part (collaborative interviews).
  participantIds  String[]
  status          InterviewStatus @default(pending)
  cancelReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, startsAt])
  @@index([applicationId])
}

// ─── Jumanly Partners (E9) ──────────────────────────────────────

/// A batch of sponsored licences bought by a partner, created by the admin after the contract.
model LicenseBatch {
  id           String        @id @default(cuid(2))
  partnerOrgId String
  partnerOrg   Organization  @relation(fields: [partnerOrgId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan          @relation(fields: [planId], references: [id])
  name         String
  seats        Int
  /// Licence length for each beneficiary, capped by the end of the contract.
  months       Int
  startsAt     DateTime
  endsAt       DateTime
  contractRef  String?
  priceCents   Int?
  /// Report cells about fewer people than this are hidden (never below 10).
  minGroup     Int           @default(10)
  createdById  String?
  licenses     License[]
  links        LicenseLink[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([partnerOrgId])
}

enum LicenseStatus {
  available
  active
  revoked
  expired
}

/// One distributed licence: a code, an e-mail invitation or an activation through a link.
model License {
  id                       String        @id @default(cuid(2))
  batchId                  String
  batch                    LicenseBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// JMLY-XXXX-XXXX, stored without separators.
  code                     String        @unique
  label                    String?
  /// E-mail invitation: only this address can activate the code.
  invitedEmail             String?
  invitedAt                DateTime?
  linkId                   String?
  link                     LicenseLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  userId                   String?
  user                     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId           String?       @unique
  status                   LicenseStatus @default(available)
  activatedAt              DateTime?
  /// The beneficiary agreed that a declared hiring counts in the partner's reports.
  outcomeConsentAt         DateTime?
  outcomeConsentAnsweredAt DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([batchId, status])
  @@index([userId])
  @@index([batchId, invitedEmail])
}

/// An invitation link shared with a group; each use activates one licence of the batch.
model LicenseLink {
  id         String       @id @default(cuid(2))
  batchId    String
  batch      LicenseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  token      String       @unique
  maxUses    Int
  expiresAt  DateTime?
  disabledAt DateTime?
  licenses   License[]
  createdAt  DateTime     @default(now())
}

/// Profile photo (docs/ux-mobile-talent, prompt 6, screen 26): cropped and resized in the browser
/// (square JPEG), kept here and served at /api/photo/{token}: an unguessable address, renewed at
/// each change, shown where the person's avatar or CV is shown. Never used for matching (CLAUDE.md,
/// golden rule 4).
model ProfilePhoto {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  contentType String
  bytes       Bytes
  updatedAt   DateTime @updatedAt
}

/// Region used to order the country list (V8 § B1): RD Congo first, then Afrique centrale, Afrique
/// de l'Ouest, the rest of Africa, then the rest of the world.
enum PlaceRegion {
  central_africa
  west_africa
  other_africa
  world
}

enum LocalityKind {
  city
  province
}

/// ISO 3166-1 countries with their French name (reference, seeded everywhere).
model Country {
  code       String      @id
  name       String
  region     PlaceRegion
  localities Locality[]
}

/// Main cities and provinces of a country (GeoNames), largest first by `rank`.
model Locality {
  id          String       @id @default(cuid())
  countryCode String
  country     Country      @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  name        String
  kind        LocalityKind @default(city)
  rank        Int          @default(0)

  @@unique([countryCode, name])
  @@index([countryCode, rank])
}
