// Schéma de données Jumanly.
// Les modèles (utilisateurs, forfaits, offres…) arrivent à partir de l'étape E1,
// d'après docs/04-modele-de-donnees.md. L'étape E0 ne pose que la connexion
// et active l'extension pgvector (recherche par similarité, utilisée à l'étape E6).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
