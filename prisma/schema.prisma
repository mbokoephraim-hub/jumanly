// Jumanly data model (docs/specifications.md, partie 04).
// Tables are added at the step that first needs them. E1: plans and entitlements,
// organizations, skills, jobs, courses, contact messages. E2: accounts (Better Auth), memberships,
// subscriptions, payments, usage counters, overrides, audit log, first talent profile fields.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Forfaits et droits (partie 05) ─────────────────────────────
// Plans and entitlements live in the database and are edited in the admin.
// Code never tests a plan code or name, only entitlement keys (CLAUDE.md § 2).

enum PlanFamily {
  talent
  rh
  company
  partner
}

enum EntitlementType {
  boolean
  level
  limit
}

model Plan {
  id            String            @id @default(cuid(2))
  code          String            @unique
  family        PlanFamily
  name          String
  tagline       String
  /// Prefix of this plan's interface texts, e.g. "pricing.talent.pro" (features, CTA, badge).
  contentKey    String
  /// USD cents; null = on quote.
  priceCents    Int?
  currency      String            @default("USD")
  interval      String            @default("month")
  isPublic      Boolean           @default(true)
  isPurchasable Boolean           @default(true)
  recommended   Boolean           @default(false)
  sortOrder     Int
  active        Boolean           @default(true)
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]    @relation("SubscriptionPlan")
  pendingFor    Subscription[]    @relation("SubscriptionPendingPlan")
  payments      Payment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([family, sortOrder])
}

model PlanEntitlement {
  id     String          @id @default(cuid(2))
  planId String
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    String
  type   EntitlementType
  /// Text value: "true", "fundamentals", "150", "-1" (unlimited), "contract".
  value  String

  @@unique([planId, key])
  @@index([key])
}

// ─── Organisations ──────────────────────────────────────────────

enum OrganizationType {
  recruiter
  company
  partner
}

model Organization {
  id          String           @id @default(cuid(2))
  type        OrganizationType
  name        String
  slug        String           @unique
  logo        String?
  description String?
  website     String?
  country     String?
  city        String?
  sector      String?
  size        String?
  verifiedAt  DateTime?
  parentId    String?
  parent      Organization?    @relation("OrganizationEntities", fields: [parentId], references: [id])
  entities    Organization[]   @relation("OrganizationEntities")
  jobs        Job[]
  memberships Membership[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ─── Référentiel de compétences ─────────────────────────────────

model Skill {
  id       String         @id @default(cuid(2))
  name     String
  slug     String         @unique
  aliases  String[]
  category String
  jobs     JobSkill[]
  courses  CourseSkill[]
  profiles ProfileSkill[]
}

// ─── Offres (Jobs) ──────────────────────────────────────────────

enum ContractType {
  cdi
  cdd
  stage
  mission
  freelance
  alternance
  volontariat
}

enum RemoteMode {
  onsite
  hybrid
  remote
}

enum JobStatus {
  draft
  published
  closed
  archived
}

enum SkillImportance {
  required
  preferred
}

model Job {
  id                String       @id @default(cuid(2))
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  title             String
  slug              String       @unique
  description       String
  /// One item per line.
  responsibilities  String[]
  requirements      String[]
  benefits          String[]
  process           String[]
  contractType      ContractType
  city              String
  country           String
  remote            RemoteMode
  /// USD cents per month; optional.
  salaryMin         Int?
  salaryMax         Int?
  currency          String       @default("USD")
  experienceMin     Int          @default(0)
  educationLevelMin String?
  /// [{ code: "fr", level: "C1" }]
  languagesRequired Json         @default("[]")
  /// Explicit criteria set by the recruiter: ["Permis B", …]
  knockoutCriteria  Json         @default("[]")
  status            JobStatus    @default(draft)
  publishedAt       DateTime?
  closesAt          DateTime?
  skills            JobSkill[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, publishedAt])
}

model JobSkill {
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance
  weight     Int             @default(3)
  minLevel   Int             @default(2)

  @@id([jobId, skillId])
}

// ─── Formations (Learn) ─────────────────────────────────────────

enum CourseLevel {
  beginner
  intermediate
  advanced
}

/// Catalog level a course requires; plans grant one through `learn.catalog.level`.
enum CatalogLevel {
  free
  fundamentals
  standard
  advanced
  specialized
}

enum CourseStatus {
  draft
  published
}

enum LessonKind {
  video
  text
  exercise
  quiz
  resource
}

model Course {
  id                 String         @id @default(cuid(2))
  slug               String         @unique
  title              String
  summary            String
  description        String
  objectives         String[]
  audience           String
  category           String
  level              CourseLevel
  language           String         @default("fr")
  durationMinutes    Int
  coverUrl           String?
  requiredLevel      CatalogLevel
  status             CourseStatus   @default(draft)
  certificateEnabled Boolean        @default(true)
  enrollmentCount    Int            @default(0)
  publishedAt        DateTime?
  modules            CourseModule[]
  skills             CourseSkill[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, publishedAt])
}

model CourseModule {
  id       String   @id @default(cuid(2))
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  lessons  Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String       @id @default(cuid(2))
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  kind        LessonKind
  videoId     String?
  durationSec Int          @default(0)
  content     Json?
  /// Visible without an account.
  isPreview   Boolean      @default(false)

  @@unique([moduleId, order])
}

model CourseSkill {
  courseId     String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill  @relation(fields: [skillId], references: [id])
  levelGranted Int    @default(2)

  @@id([courseId, skillId])
}

// ─── Formulaire de contact ──────────────────────────────────────

model ContactMessage {
  id           String   @id @default(cuid(2))
  /// "contact" (form /contact) or "partners" (form /partenaires).
  audience     String
  /// Subject code from the form (account, quote, partners…).
  subject      String
  name         String
  email        String
  organization String?
  country      String?
  message      String
  /// Extra answers (quote: users, entities; partners: type, role, beneficiaries, plan, duration).
  details      Json     @default("{}")
  /// Mailbox the message was forwarded to.
  routedTo     String
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
}

// ─── Comptes (Better Auth) ──────────────────────────────────────
// Field names of User, Session, Account, Verification, TwoFactor and RateLimit follow Better Auth.

enum PlatformRole {
  user
  content_editor
  support_agent
  platform_admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id                  String         @id @default(cuid(2))
  name                String
  email               String         @unique
  emailVerified       Boolean        @default(false)
  image               String?
  firstName           String?
  lastName            String?
  country             String?
  city                String?
  locale              String         @default("fr")
  platformRole        PlatformRole   @default(user)
  status              UserStatus     @default(active)
  /// Consent to AI suggestions (CLAUDE.md § 12): date of consent, null when withdrawn.
  aiConsentAt         DateTime?
  newsletter          Boolean        @default(false)
  termsAcceptedAt     DateTime?
  /// Account deletion requested: effective at this date unless the user signs in again.
  deletionScheduledAt DateTime?
  twoFactorEnabled    Boolean        @default(false)
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  memberships         Membership[]
  talentProfile       TalentProfile?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Appartenances (partie 05 § 5) ──────────────────────────────

enum MembershipRole {
  org_owner
  org_admin
  recruiter
  hiring_manager
  viewer
  partner_manager
}

enum MembershipStatus {
  invited
  active
  removed
}

model Membership {
  id             String           @id @default(cuid(2))
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  status         MembershipStatus @default(active)
  /// Job title given at sign-up (« Votre fonction »).
  jobTitle       String?
  invitedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─── Abonnements, paiements, quotas (parties 05, 09) ────────────

enum SubjectType {
  user
  organization
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
  sponsored
}

enum SubscriptionSource {
  self
  license
  admin
}

model Subscription {
  id                 String             @id @default(cuid(2))
  subjectType        SubjectType
  subjectId          String
  planId             String
  plan               Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Downgrade taking effect at the end of the paid period.
  pendingPlanId      String?
  pendingPlan        Plan?              @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  source             SubscriptionSource @default(self)
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([subjectType, subjectId])
}

enum PaymentMethod {
  mobile_money
  card
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  refunded
}

model Payment {
  id             String        @id @default(cuid(2))
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  /// Who pays and for which plan, kept even before the subscription exists.
  subjectType    SubjectType
  subjectId      String
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  provider       String
  method         PaymentMethod
  operator       String?
  /// Mobile Money number, masked (e.g. ••••••4521); never stored in full.
  msisdnMasked   String?
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(pending)
  providerRef    String        @unique
  idempotencyKey String        @unique
  failureReason  String?
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subjectType, subjectId])
}

/// Consumption of a quota for one period (rolling month from the subscription start).
model UsageCounter {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  periodStart DateTime
  periodEnd   DateTime
  used        Int         @default(0)

  @@unique([subjectType, subjectId, key, periodStart])
}

/// Per-subject entitlement value (commercial gesture, Premium contract).
model EntitlementOverride {
  id          String      @id @default(cuid(2))
  subjectType SubjectType
  subjectId   String
  key         String
  value       String
  reason      String
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId])
}

// ─── Profil talent (début, complété en E3) ──────────────────────

enum ProfileVisibility {
  private
  recruiters
  anonymous
}

model TalentProfile {
  id         String            @id @default(cuid(2))
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline   String?
  /// Main goal chosen on the welcome screen (firstJob, newJob, reconversion…).
  goal       String?
  targetJob  String?
  visibility ProfileVisibility @default(private)
  skills     ProfileSkill[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum SkillSource {
  declared
  course
  assessment
  cv_extracted
}

model ProfileSkill {
  id        String        @id @default(cuid(2))
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill         @relation(fields: [skillId], references: [id])
  /// 1 to 4: notions, intermediate, advanced, expert.
  level     Int           @default(2)
  source    SkillSource   @default(declared)
  verified  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@unique([profileId, skillId])
}

// ─── Audit (partie 03 § 3.6) ────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid(2))
  actorId        String?
  action         String
  targetType     String
  targetId       String
  organizationId String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}
